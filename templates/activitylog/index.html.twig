{% extends 'base.html.twig' %}

{% block title %}Activity Logs{% endblock %}

{% block body %}
<style>
    :root {
        --gold: #c9a84c;
        --gold-light: #e8d5a3;
        --glass-border: rgba(201, 168, 76, 0.2);
        --text-primary: #f0ede8;
        --text-muted: #a89880;
    }

    .logs-page {
        min-height: 100vh;
        padding: 1.5rem;
        background-color: #0a1f0a;
        font-family: 'Jost', 'Segoe UI', sans-serif;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid white;
        border-radius: 0.75rem;
        flex: 1;
        padding: 1rem;
        transition: all 0.2s ease;
    }
    .stat-card:hover { background: rgba(255, 255, 255, 0.12); }
    .stat-label { font-size: 0.75rem; color: rgba(255,255,255,0.6); letter-spacing: 0.05em; }
    .stat-value { font-size: 1.4rem; font-weight: 600; color: white; margin-top: 4px; }

    /* Filter form */
    .filter-bar {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(201,168,76,0.2);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .filter-bar select,
    .filter-bar input[type="date"] {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 0.5rem;
        color: white;
        padding: 7px 12px;
        font-size: 0.8rem;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s;
    }
    .filter-bar select:focus,
    .filter-bar input[type="date"]:focus {
        border-color: var(--gold);
    }
    .filter-bar select option { background: #0a1f0a; color: white; }

    .btn-filter {
        padding: 7px 20px;
        background: transparent;
        border: 1px solid var(--gold);
        border-radius: 50px;
        color: var(--gold);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.3s ease;
    }
    .btn-filter:hover {
        background: rgba(201,168,76,0.1);
        box-shadow: 0 0 16px rgba(201,168,76,0.15);
    }

    /* Table */
    .table-wrapper {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(201,168,76,0.2);
        border-radius: 0.75rem;
        overflow: hidden;
    }

    .logs-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

    .logs-table thead tr {
        background: rgba(1, 68, 33, 0.5);
        border-bottom: 1px solid rgba(201,168,76,0.2);
    }

    .logs-table th {
        padding: 12px 16px;
        text-align: left;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.6);
    }

    .logs-table tbody tr {
        border-bottom: 1px solid rgba(255,255,255,0.05);
        transition: background 0.2s ease;
    }
    .logs-table tbody tr:hover { background: rgba(255,255,255,0.04); }
    .logs-table tbody tr:last-child { border-bottom: none; }
    .logs-table td { padding: 12px 16px; color: rgba(255,255,255,0.7); font-size: 0.85rem; }

    /* Action badges */
    .action-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 50px;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .action-login    { background: rgba(126,203,158,0.1); border: 1px solid rgba(126,203,158,0.3); color: #7ecb9e; }
    .action-logout   { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); color: rgba(255,255,255,0.5); }
    .action-create   { background: rgba(122,184,232,0.1); border: 1px solid rgba(122,184,232,0.3); color: #7ab8e8; }
    .action-update   { background: rgba(201,168,76,0.1); border: 1px solid rgba(201,168,76,0.3); color: var(--gold-light); }
    .action-delete   { background: rgba(232,122,122,0.1); border: 1px solid rgba(232,122,122,0.3); color: #e87a7a; }
    .action-default  { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.4); }

    /* Role badge */
    .role-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 50px;
        font-size: 0.65rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }
    .role-admin { background: rgba(201,168,76,0.15); border: 1px solid rgba(201,168,76,0.4); color: var(--gold-light); }
    .role-staff { background: rgba(122,184,232,0.1); border: 1px solid rgba(122,184,232,0.3); color: #7ab8e8; }
    .role-user  { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); color: rgba(255,255,255,0.4); }

    /* Pagination */
    .pagination { display: flex; justify-content: center; gap: 0.5rem; margin-top: 1.5rem; }
    .page-btn {
        padding: 5px 14px;
        border-radius: 6px;
        font-size: 0.8rem;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.5);
        transition: all 0.2s;
    }
    .page-btn:hover { border-color: var(--gold); color: var(--gold); }
    .page-btn.active { border-color: var(--gold); color: var(--gold); background: rgba(201,168,76,0.1); }
</style>

<div class="logs-page">
    <div style="max-width: 1200px; margin: 0 auto;">

        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-light text-white">Activity Logs</h1>
                <p class="text-sm mt-1" style="color: rgba(255,255,255,0.4);">Track all user actions</p>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="flex gap-3 mb-6">
            <div class="stat-card">
                <p class="stat-label">Total Logs</p>
                <p class="stat-value">{{ pagination.total }}</p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Logins</p>
                <p class="stat-value" style="color: #7ecb9e;">
                    {{ logs|filter(l => l.action == 'LOGIN')|length }}
                </p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Changes</p>
                <p class="stat-value" style="color: #7ab8e8;">
                    {{ logs|filter(l => l.action in ['CREATE','UPDATE','DELETE'])|length }}
                </p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Page</p>
                <p class="stat-value" style="color: var(--gold);">
                    {{ pagination.page }} / {{ pagination.pages }}
                </p>
            </div>
        </div>

        <!-- Filter Bar -->
        <form method="get" action="{{ path('app_activity_log_index') }}" class="filter-bar">
            <select name="username">
                <option value="">All Users</option>
                {% for user in usernames %}
                    <option value="{{ user }}" {% if app.request.get('username') == user %}selected{% endif %}>
                        {{ user }}
                    </option>
                {% endfor %}
            </select>

            <select name="action">
                <option value="">All Actions</option>
                {% for act in ['LOGIN','LOGOUT','CREATE','UPDATE','DELETE'] %}
                    <option value="{{ act }}" {% if app.request.get('action') == act %}selected{% endif %}>
                        {{ act }}
                    </option>
                {% endfor %}
            </select>

            <input type="date" name="date" value="{{ app.request.get('date') }}">

            <button type="submit" class="btn-filter">Filter</button>

            {% if app.request.get('username') or app.request.get('action') or app.request.get('date') %}
                <a href="{{ path('app_activity_log_index') }}"
                   style="color: #e87a7a; font-size: 0.75rem; text-decoration: none; letter-spacing: 0.05em;">
                    ✕ Clear
                </a>
            {% endif %}
        </form>

        <!-- Table -->
        <div class="table-wrapper">
            <table class="logs-table">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Target Data</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        <tr>
                            <td style="color: var(--gold); font-weight: 500;">
                                #{{ log.user ? log.user.id : '—' }}
                            </td>
                            <td style="color: white;">{{ log.username ?? '—' }}</td>
                            <td>
                                {% set role = log.userRole %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="role-badge role-admin">Admin</span>
                                {% elseif role == 'ROLE_STAFF' %}
                                    <span class="role-badge role-staff">Staff</span>
                                {% else %}
                                    <span class="role-badge role-user">User</span>
                                {% endif %}
                            </td>
                            <td>
                                {% set act = log.action %}
                                {% if act == 'LOGIN' %}
                                    <span class="action-badge action-login">🔐 Login</span>
                                {% elseif act == 'LOGOUT' %}
                                    <span class="action-badge action-logout">🚪 Logout</span>
                                {% elseif act == 'CREATE' %}
                                    <span class="action-badge action-create">✨ Create</span>
                                {% elseif act == 'UPDATE' %}
                                    <span class="action-badge action-update">✏️ Update</span>
                                {% elseif act == 'DELETE' %}
                                    <span class="action-badge action-delete">🗑️ Delete</span>
                                {% else %}
                                    <span class="action-badge action-default">{{ act }}</span>
                                {% endif %}
                            </td>
                            <td style="color: rgba(255,255,255,0.5); font-size: 0.78rem; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                {{ log.targetData ? log.targetData|slice(0, 60) ~ (log.targetData|length > 60 ? '...' : '') : '—' }}
                            </td>
                            <td style="white-space: nowrap; color: rgba(255,255,255,0.5); font-size: 0.78rem;">
                                {{ log.dateTime|date('d/m/Y h:i:s A') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" style="text-align:center; padding:3rem; color:rgba(255,255,255,0.3); font-style:italic;">
                                No logs found
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        {% if pagination.pages > 1 %}
            <div class="pagination">
                {% for i in 1..pagination.pages %}
                    <a href="{{ path('app_activity_log_index', {
                        page: i,
                        username: app.request.get('username'),
                        action: app.request.get('action'),
                        date: app.request.get('date')
                    }) }}" class="page-btn {{ pagination.page == i ? 'active' : '' }}">
                        {{ i }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}