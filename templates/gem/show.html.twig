{% extends 'base.html.twig' %}

{% block title %}Gem Details{% endblock %}

{% block body %}
<style>
    .icon-white { filter: brightness(0) invert(1); }
    .glass-card {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        transition: all 0.2s ease;
    }
    .detail-row {
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .detail-row:last-child {
        border-bottom: none;
    }
    
    /* Force all text white */
    body, div, p, span, label, h1, h2, h3, h4, h5, h6, .text-white\/40, .text-white\/70 {
        color: white !important;
    }
    
    /* Keep stock colors */
    .text-yellow-400 {
        color: #facc15 !important;
    }
    .text-red-400 {
        color: #f87171 !important;
    }
</style>

<div class="min-h-screen p-6" style="background-color: #0a1f0a;">
    <div class="max-w-4xl mx-auto">
        
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-light">{{ gem.gemtype ? gem.gemtype.name : 'Gem Details' }}</h1>
                <p class="text-xs mt-1" style="color: rgba(255,255,255,0.4);">ID: {{ gem.id }}</p>
            </div>
            <a href="{{ path('app_gem_index') }}" class="px-4 py-2 bg-white/10 rounded-xl text-sm hover:bg-white/20 transition border border-white/20 flex items-center gap-2" style="color: white;">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Back to List
            </a>
        </div>

        <!-- Main Glass Card -->
        <div class="glass-card p-6">
            
            <!-- Image + Stats -->
            <div class="flex gap-6 mb-6 pb-6 border-b border-white/10">
                <div class="w-32 h-32 rounded-xl overflow-hidden bg-white/5 flex-shrink-0">
                    {% if gem.imagepath %}
                        <img src="/images/gems/{{ gem.imagepath }}" 
                             onerror="this.src='/images/default-gem.webp'"
                             class="w-full h-full object-cover">
                    {% else %}
                        <div class="w-full h-full flex items-center justify-center">
                            <svg class="w-12 h-12" style="color: rgba(255,255,255,0.2);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                        </div>
                    {% endif %}
                </div>
                
                <div class="flex-1">
                    <div class="grid grid-cols-3 gap-4">
                        <div>
                            <p class="text-xs uppercase tracking-wider" style="color: rgba(255,255,255,0.4);">Price</p>
                            <p class="text-2xl font-semibold" style="color: white;">${{ gem.price|number_format(2) }}</p>
                        </div>
                        <div>
                            <p class="text-xs uppercase tracking-wider" style="color: rgba(255,255,255,0.4);">Stock</p>
                            <p class="text-2xl font-semibold {% if gem.stock <= 5 and gem.stock > 0 %}text-yellow-400{% elseif gem.stock == 0 %}text-red-400{% else %}text-white{% endif %}">
                                {{ gem.stock }}
                            </p>
                        </div>
                        <div>
                            <p class="text-xs uppercase tracking-wider" style="color: rgba(255,255,255,0.4);">Type</p>
                            <p class="text-2xl font-semibold" style="color: white;">{{ gem.gemtype ? gem.gemtype.name : 'N/A' }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- All Details in Clean Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                <div class="detail-row">
                    <p class="text-xs uppercase tracking-wider" style="color: rgba(255,255,255,0.4);">Carat</p>
                    <p class="text-base mt-1" style="color: white;">{{ gem.carat ?: '—' }}</p>
                </div>
                <div class="detail-row">
                    <p class="text-xs uppercase tracking-wider" style="color: rgba(255,255,255,0.4);">Size</p>
                    <p class="text-base mt-1" style="color: white;">{{ gem.size ?: '—' }}</p>
                </div>
                <div class="detail-row">
                    <p class="text-xs uppercase tracking-wider" style="color: rgba(255,255,255,0.4);">Cut</p>
                    <p class="text-base mt-1" style="color: white;">{{ gem.cut ?: '—' }}</p>
                </div>
                <div class="detail-row">
                    <p class="text-xs uppercase tracking-wider" style="color: rgba(255,255,255,0.4);">Color</p>
                    <p class="text-base mt-1" style="color: white;">{{ gem.color ?: '—' }}</p>
                </div>
                <div class="detail-row">
                    <p class="text-xs uppercase tracking-wider" style="color: rgba(255,255,255,0.4);">Clarity</p>
                    <p class="text-base mt-1" style="color: white;">{{ gem.clarity ?: '—' }}</p>
                </div>
                <div class="detail-row">
                    <p class="text-xs uppercase tracking-wider" style="color: rgba(255,255,255,0.4);">Origin</p>
                    <p class="text-base mt-1" style="color: white;">{{ gem.origin ?: '—' }}</p>
                </div>
                <div class="detail-row md:col-span-2">
                    <p class="text-xs uppercase tracking-wider" style="color: rgba(255,255,255,0.4);">Description</p>
                    <p class="text-sm mt-1" style="color: rgba(255,255,255,0.7);">{{ gem.description ?: 'No description available' }}</p>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex gap-3 pt-6 mt-4 border-t border-white/10">
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                    <a href="{{ path('app_gem_edit', {'id': gem.id}) }}" class="px-5 py-2 bg-white/10 rounded-lg text-sm hover:bg-white/20 transition flex items-center gap-2" style="color: white;">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                        </svg>
                        Edit
                    </a>
                    <form method="post" action="{{ path('app_gem_delete', {'id': gem.id}) }}" onsubmit="return confirm('Are you sure you want to delete this gem?');" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ gem.id) }}">
                        <button type="submit" class="px-5 py-2 bg-red-500/20 rounded-lg text-sm text-red-300 hover:bg-red-500/30 transition flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                            Delete
                        </button>
                    </form>
                {% endif %}
                <a href="{{ path('app_gem_index') }}" class="px-5 py-2 bg-white/5 rounded-lg text-sm hover:bg-white/10 transition ml-auto" style="color: rgba(255,255,255,0.6);">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}