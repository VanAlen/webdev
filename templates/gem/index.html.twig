{% extends 'base.html.twig' %}

{% block title %}Gem List{% endblock %}

{% block body %}
<style>
    .icon-white { filter: brightness(0) invert(1); }
    .table-container {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 1rem;
        overflow: hidden;
    }
    table th {
        background: rgba(255, 255, 255, 0.08);
        color: white;
        font-weight: 500;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    table td {
        color: white;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    table tr:hover {
        background: rgba(255, 255, 255, 0.05);
    }
</style>

<div class="min-h-screen p-6" style="background-color: #0a1f0a;">
    <div class="max-w-7xl mx-auto">
    
<!-- Header -->
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-light text-white">Gems</h1>
        <p class="text-sm text-white/50 mt-1">Manage your gem collection</p>
    </div>
    <div class="flex items-center gap-3">
        <a href="{{ path('app_admin_index') }}" class="p-2 bg-white/10 rounded-xl text-white hover:bg-white/20 transition border border-white/20" title="Dashboard">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
        </a>
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
            <a href="{{ path('app_gem_new') }}" class="px-4 py-2 bg-white/10 rounded-xl text-sm text-white hover:bg-white/20 transition border border-white/20 flex items-center gap-2">
                <img src="/images/svg/add_2.svg" class="w-4 h-4 icon-white opacity-70 hover:opacity-100">
                Add Gem
            </a>
        {% endif %}
    </div>
</div>

        <!-- Flash Messages -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 px-4 py-3 rounded-xl {{ label == 'success' ? 'bg-green-500/20 border border-green-500/30 text-green-300' : 'bg-red-500/20 border border-red-500/30 text-red-300' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Table -->
        <div class="table-container">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">ID</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Gem Type</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Carat</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Size</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Cut</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Color</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Clarity</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Origin</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Stock</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Price</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-white/60 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for gem in gems %}
                        <tr class="hover:bg-white/5 transition">
                            <td class="px-4 py-3 text-sm text-white/80">{{ gem.id }}</td>
                            <td class="px-4 py-3 text-sm text-white">{{ gem.gemtype.name }}</td>
                            <td class="px-4 py-3 text-sm text-white/80">{{ gem.carat }}</td>
                            <td class="px-4 py-3 text-sm text-white/80">{{ gem.size }}</td>
                            <td class="px-4 py-3 text-sm text-white/80">{{ gem.cut }}</td>
                            <td class="px-4 py-3 text-sm text-white/80">{{ gem.color }}</td>
                            <td class="px-4 py-3 text-sm text-white/80">{{ gem.clarity }}</td>
                            <td class="px-4 py-3 text-sm text-white/80">{{ gem.origin }}</td>
                            <td class="px-4 py-3">
                                {% if gem.stock == 0 %}
                                    <span class="px-2 py-1 text-xs rounded-full bg-red-500/20 text-red-300">{{ gem.stock }}</span>
                                {% elseif gem.stock <= 5 %}
                                    <span class="px-2 py-1 text-xs rounded-full bg-yellow-500/20 text-yellow-300">{{ gem.stock }}</span>
                                {% else %}
                                    <span class="text-sm text-white/80">{{ gem.stock }}</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-sm font-medium text-white">₱{{ gem.price }}</td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="{{ path('app_gem_show', {'id': gem.id}) }}" class="p-1 rounded hover:bg-white/10 transition" title="View">
                                        <img src="/images/svg/eye.svg" class="w-4 h-4 icon-white opacity-70 hover:opacity-100">
                                    </a>
                                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                                        <a href="{{ path('app_gem_edit', {'id': gem.id}) }}" class="p-1 rounded hover:bg-white/10 transition" title="Edit">
                                            <img src="/images/svg/edit_1.svg" class="w-4 h-4 icon-white opacity-70 hover:opacity-100">
                                        </a>
                                        <button type="button"
                                            onclick="openDeleteModal('{{ path('app_gem_delete', {'id': gem.id}) }}', '{{ csrf_token('delete' ~ gem.id) }}', '{{ gem.gemtype.name }} #{{ gem.id }}')"
                                            class="p-1 rounded hover:bg-white/10 transition" title="Delete">
                                            <img src="/images/svg/trash_4.svg" class="w-4 h-4 icon-white opacity-70 hover:opacity-100">
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="11" class="px-4 py-8 text-center text-white/40">No gems found</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
    <div style="background: #0f2a0f; border: 1px solid rgba(255,255,255,0.12); border-radius: 1rem; padding: 1.5rem; width: 100%; max-width: 360px;">
        <div class="flex items-center gap-3 mb-3">
            <div class="flex items-center justify-center w-9 h-9 rounded-full bg-red-500/20 border border-red-500/30">
                <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-white text-sm font-medium">Delete gem?</p>
                <p id="modal-gem-name" class="text-white/40 text-xs"></p>
            </div>
        </div>
        <p class="text-white/50 text-xs mb-4 leading-relaxed">
            This will permanently delete the gem and all associated data. This action cannot be undone.
        </p>
        <div class="flex gap-2 justify-end">
            <button type="button" onclick="closeDeleteModal()"
                class="px-4 py-1.5 bg-white/10 border border-white/20 rounded-lg text-xs text-white/70 hover:bg-white/20 transition">
                Cancel
            </button>
            <form id="delete-form" method="post">
                <input type="hidden" id="delete-token" name="_token" value="">
                <button type="submit" class="px-4 py-1.5 bg-red-500/30 border border-red-500/40 rounded-lg text-xs text-red-300 hover:bg-red-500/40 transition">
                    Yes, delete
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function openDeleteModal(action, token, name) {
        document.getElementById('delete-form').action = action;
        document.getElementById('delete-token').value = token;
        document.getElementById('modal-gem-name').textContent = name;
        document.getElementById('delete-modal').classList.remove('hidden');
    }
    function closeDeleteModal() {
        document.getElementById('delete-modal').classList.add('hidden');
    }
</script>

{% endblock %}