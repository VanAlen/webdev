{% extends 'base.html.twig' %}

{% block title %}Create New Gem Bundle{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-10">
  <div class="container mx-auto px-4">
    <h1 class="text-3xl font-bold mb-8 text-gray-800 text-center">Create New Gem Bundle</h1>

    <div class="bg-white shadow-lg rounded-xl p-8 border border-gray-200">
      {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data', 'class': 'space-y-6' } }) }}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for field in form %}
          {% if field.vars.name != '_token' %}
            <div class="space-y-2">
              {{ form_label(field, null, {
                'label_attr': {
                  'class': 'block text-sm font-medium text-gray-700 mb-1'
                }
              }) }}
              
              {{ form_widget(field, {
                'attr': {
                  'class': 'block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200'
                }
              }) }}
              
              {{ form_help(field, {
                'help_attr': {
                  'class': 'text-sm text-gray-500 mt-1'
                }
              }) }}
              
              {{ form_errors(field, {
                'attr': {
                  'class': 'text-sm text-red-600 mt-1'
                }
              }) }}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="mt-8 flex space-x-4 justify-end">
        <button type="submit" class="flex items-center px-6 py-3 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition duration-200 shadow-sm">
          Create Bundle
        </button>
        <a href="{{ path('app_gembundles_index') }}" class="flex items-center px-6 py-3 bg-gray-200 text-gray-800 font-medium rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 transition duration-200 shadow-sm">
          Back to list
        </a>
      </div>

      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}