{% extends 'base.html.twig' %}

{% block title %}Edit Gem Bundle{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-20">
  <div class="container mx-auto px-4">
    <h1 class="text-3xl font-bold mb-8 text-gray-800 text-center">Edit Gem Bundle</h1>

    <div class="bg-white shadow-md rounded-lg p-6 flex flex-col md:flex-row md:space-x-10">
    <!-- Image on the left -->
    <div class="md:w-1/3 flex justify-center items-start mb-6 md:mb- text-forest">
        {% if gembundle.image %}
        <img src="{{ asset(gembundle.image) }}"
            alt="{{ gembundle.name }}"
            class="w-[300px] h-auto rounded shadow">
        {% else %}
        <img src="{{ asset('images/default-bundle.webp') }}"
            alt="No image"
            class="w-[500px] h-auto rounded shadow opacity-50">
        {% endif %}
    </div>

    <!-- Form on the right -->
    <div class="md:w-2/3 text-forest">
        {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data' } }) }}

        <div class="grid grid-cols-2 gap-6 text-forest">
        {{ form_row(form.name) }}
        {{ form_row(form.price) }}
        {{ form_row(form.stock) }}
        {{ form_row(form.description, {'attr': {'class': 'border rounded p-2 w-full h-48'}}) }}
        {{ form_row(form.image) }}
        {{ form_row(form.created_at) }}
        </div>

        <div class="mt-6 flex space-x-4 justify-end">
        <button type="submit" class="px-5 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Update</button>
        <a href="{{ path('app_gembundles_index') }}" class="px-5 py-2 bg-gray-500 text-white rounded hover:bg-gray-600">Back to list</a>
        </div>

        {{ form_end(form) }}
    </div>
    </div>

  </div>
</div>
{% endblock %}
