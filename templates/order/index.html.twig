{% extends 'base.html.twig' %}

{% block title %}Orders{% endblock %}

{% block body %}
<style>
    :root {
        --gold: #c9a84c;
        --gold-light: #e8d5a3;
        --glass-border: rgba(201, 168, 76, 0.2);
        --glass-card: rgba(255, 255, 255, 0.04);
        --text-primary: #f0ede8;
        --text-muted: #a89880;
    }

    .orders-page {
        min-height: 100vh;
        padding: 1.5rem;
        background-color: #0a1f0a;
        font-family: 'Jost', 'Segoe UI', sans-serif;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid white;
        border-radius: 0.75rem;
        flex: 1;
        padding: 1rem;
        transition: all 0.2s ease;
    }
    .stat-card:hover {
        background: rgba(201, 168, 76, 0.08);
    }
    .stat-label {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.6);
        letter-spacing: 0.05em;
    }
    .stat-value {
        font-size: 1.4rem;
        font-weight: 600;
        color: white;
        margin-top: 4px;
    }

    .table-wrapper {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(201, 168, 76, 0.2);
        border-radius: 0.75rem;
        overflow: hidden;
    }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

    .orders-table thead tr {
        background: rgba(1, 68, 33, 0.5);
        border-bottom: 1px solid rgba(201, 168, 76, 0.2);
    }

    .orders-table th {
        padding: 12px 16px;
        text-align: left;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.6);
    }

    .orders-table tbody tr {
        border-bottom: 1px solid rgba(255,255,255,0.05);
        transition: background 0.2s ease;
    }

    .orders-table tbody tr:hover {
        background: rgba(255, 255, 255, 0.04);
    }

    .orders-table tbody tr:last-child { border-bottom: none; }

    .orders-table td {
        padding: 12px 16px;
        color: rgba(255,255,255,0.7);
    }

    .status-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 50px;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border: 1px solid rgba(201, 168, 76, 0.3);
        color: var(--gold-light);
        background: rgba(201, 168, 76, 0.08);
    }

    .action-show  { color: #7ab8e8; text-decoration: none; font-size: 0.78rem; }
    .action-edit  { color: var(--gold); text-decoration: none; font-size: 0.78rem; margin-left: 10px; }
    .action-delete {
        background: none; border: none; color: #e87a7a;
        font-size: 0.78rem; margin-left: 10px; cursor: pointer;
        padding: 0; font-family: inherit;
    }
    .action-show:hover  { color: #a8d0f0; }
    .action-edit:hover  { color: var(--gold-light); }
    .action-delete:hover { color: #f0a0a0; }

    .btn-new {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 20px;
        background: transparent;
        border: 1px solid var(--gold);
        border-radius: 50px;
        color: var(--gold) !important;
        text-decoration: none;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: all 0.3s ease;
    }
    .btn-new:hover {
        background: rgba(201, 168, 76, 0.1);
        box-shadow: 0 0 16px rgba(201, 168, 76, 0.15);
        text-decoration: none;
    }
</style>

<div class="orders-page">
    <div style="max-width: 1200px; margin: 0 auto;">

        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-light text-white">Orders</h1>
                <p class="text-sm mt-1" style="color: rgba(255,255,255,0.4);">Manage customer orders</p>
            </div>
            <a href="{{ path('app_order_new') }}" class="btn-new">
               
                New Order
            </a>
        </div>

        <!-- Stats Row -->
        <div class="flex gap-3 mb-8">
            <div class="stat-card">
                <p class="stat-label">Total Orders</p>
                <p class="stat-value">{{ orders|length }}</p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Pending</p>
                <p class="stat-value" style="color: #e8c84c;">
                    {{ orders|filter(o => o.status == 'pending')|length }}
                </p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Completed</p>
                <p class="stat-value" style="color: #7ecb9e;">
                    {{ orders|filter(o => o.status == 'completed')|length }}
                </p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Total Value</p>
                <p class="stat-value" style="color: var(--gold);">
                    ${{ orders|reduce((carry, o) => carry + o.amount, 0)|number_format(2) }}
                </p>
            </div>
        </div>

        <!-- Table -->
        <div class="table-wrapper">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Created At</th>
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                            <th>Created By</th>
                        {% endif %}
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td style="color: var(--gold); font-weight:500;">#{{ order.id }}</td>
                            <td style="color: white;">{{ order.customer ? order.customer.username : '—' }}</td>
                            <td><span class="status-badge">{{ order.status|capitalize }}</span></td>
                            <td style="color: var(--gold-light);">${{ order.amount|number_format(2, '.', ',') }}</td>
                            <td>{{ order.createdAt ? order.createdAt|date('Y-m-d H:i') : '—' }}</td>
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                                <td>{{ order.createdBy ? order.createdBy.username : '—' }}</td>
                            {% endif %}
                            <td style="text-align:right; white-space:nowrap;">
                                <a href="{{ path('app_order_show', {'id': order.id}) }}" class="action-show">View</a>
                                {% if is_granted('ROLE_ADMIN') or (is_granted('ROLE_STAFF') and order.createdBy == app.user) %}
                                    <a href="{{ path('app_order_edit', {'id': order.id}) }}" class="action-edit">Edit</a>
                                    <form method="post"
                                          action="{{ path('app_order_delete', {'id': order.id}) }}"
                                          class="inline"
                                          onsubmit="return confirm('Delete this order?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                                        <button type="submit" class="action-delete">Delete</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" style="text-align:center; padding:3rem; color:rgba(255,255,255,0.3); font-style:italic;">
                                No orders found
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</div>
{% endblock %}