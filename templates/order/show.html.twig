{% extends 'base.html.twig' %}

{% block title %}Order #{{ order.id }} - Details{% endblock %}

{% block body %}
<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        transition: all 0.2s ease;
    }
    .glass-card:hover {
        background: rgba(255, 255, 255, 0.12);
    }
    .status-pending { background: rgba(234, 179, 8, 0.2); color: #fde047; border: 1px solid rgba(234, 179, 8, 0.3); }
    .status-processing { background: rgba(59, 130, 246, 0.2); color: #93c5fd; border: 1px solid rgba(59, 130, 246, 0.3); }
    .status-completed { background: rgba(34, 197, 94, 0.2); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.3); }
    .status-shipped { background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }
    .status-cancelled { background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3); }
    .stat-box {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 0.75rem;
        padding: 1rem;
        text-align: center;
    }
    body, div, p, span, label, h1, h2, h3, h4, th, td {
        color: white !important;
    }
    table {
        width: 100%;
        border-collapse: collapse;
    }
    th {
        text-align: left;
        padding: 0.75rem 1rem;
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(255, 255, 255, 0.5) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    tr:hover {
        background: rgba(255, 255, 255, 0.03);
    }
    .btn-action {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 0.5rem;
        padding: 0.4rem 0.8rem;
        font-size: 0.7rem;
        transition: all 0.2s;
    }
    .btn-action:hover {
        background: rgba(255, 255, 255, 0.2);
    }
</style>

<div class="min-h-screen p-6" style="background-color: #0a1f0a;">
    <div class="max-w-7xl mx-auto">

        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div>
                <h1 class="text-2xl font-light text-white">Order #{{ order.id }}</h1>
                <p class="text-sm text-white/40 mt-1">Created {{ order.createdAt|date('F j, Y') }} at {{ order.createdAt|date('g:i A') }}</p>
            </div>
            <div class="flex gap-3">
                <a href="{{ path('app_order_index') }}" class="px-4 py-2 bg-white/10 rounded-xl text-sm text-white hover:bg-white/20 transition flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Back
                </a>
                <a href="{{ path('app_order_edit', {'id': order.id}) }}" class="px-4 py-2 bg-white/20 rounded-xl text-sm text-white hover:bg-white/30 transition flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                    </svg>
                    Edit
                </a>
            </div>
        </div>

        <!-- Status Badge -->
        <div class="mb-6">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium status-{{ order.status }}">
                Status: {{ order.status|capitalize }}
            </span>
        </div>

        <!-- Order Info Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-6">
            <div class="glass-card p-4">
                <p class="text-xs text-white/40 uppercase tracking-wider mb-2">Customer</p>
                <p class="text-white font-medium">{{ order.customer ? order.customer.username : 'No customer' }}</p>
                <p class="text-xs text-white/40 mt-1">ID: {{ order.customer.id|default('N/A') }}</p>
            </div>
            <div class="glass-card p-4">
                <p class="text-xs text-white/40 uppercase tracking-wider mb-2">Total Amount</p>
                <p class="text-3xl font-semibold text-white">${{ order.amount|number_format(2) }}</p>
            </div>
            <div class="glass-card p-4">
                <p class="text-xs text-white/40 uppercase tracking-wider mb-2">Items</p>
                <p class="text-3xl font-semibold text-white">{{ order.orderitems|length }}</p>
            </div>
        </div>

        <!-- Order Items Table -->
        <div class="glass-card mb-6">
            <div class="px-5 py-4 border-b border-white/10 flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-white font-medium">Order Items</h2>
                <a href="{{ path('app_orderitem_new', {'order_id': order.id}) }}" class="px-3 py-1.5 bg-white/10 rounded-lg text-xs text-white hover:bg-white/20 transition flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add Item
                </a>
            </div>
            
            {% if order.orderitems|length > 0 %}
                <div class="overflow-x-auto">
                    <table>
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Type</th>
                                <th>Details</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in order.orderitems %}
                                <tr>
                                    <td class="text-white font-medium">
                                        {% if item.gem %}
                                            {{ item.gem.description|slice(0, 30) }}
                                        {% elseif item.jewelry %}
                                            {{ item.jewelry.name }}
                                        {% elseif item.gembundle %}
                                            {{ item.gembundle.name }}
                                        {% elseif item.customjewelries %}
                                            Custom #{{ item.customjewelries.id }}
                                        {% else %}
                                            —
                                        {% endif %}
                                        <div class="text-xs text-white/40">ID: {{ item.id }}</div>
                                    </td>
                                    <td>
                                        <span class="text-xs px-2 py-0.5 rounded-full bg-white/10">
                                            {% if item.gem %}Gem
                                            {% elseif item.jewelry %}Jewelry
                                            {% elseif item.gembundle %}Bundle
                                            {% elseif item.customjewelries %}Custom
                                            {% endif %}
                                        </span>
                                    </td>
                                    <td class="text-sm text-white/60">
                                        {% if item.gem %}
                                            {{ item.gem.carat }}ct • {{ item.gem.color|default('—') }}
                                        {% elseif item.jewelry %}
                                            {{ item.jewelry.material|default('—') }}
                                        {% elseif item.gembundle %}
                                            {{ item.gembundle.gemtypes|length }} types
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="text-white">{{ item.quantity }}</td>
                                    <td class="text-white/80">${{ item.priceSnapshot|number_format(2) }}</td>
                                    <td class="text-white font-medium">${{ (item.quantity * item.priceSnapshot)|number_format(2) }}</td>
                                    <td>
                                        <a href="{{ path('app_orderitem_edit', {'id': item.id}) }}" class="text-white/50 hover:text-white text-sm">Edit</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr style="border-top: 1px solid rgba(255,255,255,0.1);">
                                <td colspan="5" class="text-right font-medium text-white">Total</td>
                                <td class="font-bold text-white text-lg">${{ order.amount|number_format(2) }}</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-12">
                    <p class="text-white/40 mb-4">No items in this order</p>
                    <a href="{{ path('app_orderitem_new', {'order_id': order.id}) }}" class="px-4 py-2 bg-white/20 rounded-lg text-white hover:bg-white/30 transition inline-flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        Add First Item
                    </a>
                </div>
            {% endif %}
        </div>

        <!-- Stats Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="stat-box">
                <p class="text-2xl font-bold text-white">{{ order.orderitems|length }}</p>
                <p class="text-xs text-white/40 uppercase tracking-wider">Total Items</p>
            </div>
            <div class="stat-box">
                <p class="text-2xl font-bold text-white">${{ order.amount|number_format(2) }}</p>
                <p class="text-xs text-white/40 uppercase tracking-wider">Total Amount</p>
            </div>
            <div class="stat-box">
                {% set avgPrice = order.orderitems|length > 0 ? order.amount / order.orderitems|length : 0 %}
                <p class="text-2xl font-bold text-white">${{ avgPrice|number_format(2) }}</p>
                <p class="text-xs text-white/40 uppercase tracking-wider">Average Price</p>
            </div>
        </div>

        <!-- Delete Action -->
        <div class="glass-card p-4">
            <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" onsubmit="return confirm('Delete this order permanently?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                <button type="submit" class="text-red-400 hover:text-red-300 text-sm flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Delete Order
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}