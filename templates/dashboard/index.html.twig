{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<style>
    .icon-white {
        filter: brightness(0) invert(1);
    }
    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 1rem;
    }
    .stat-box {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
    }
</style>

<div class="min-h-screen flex items-center justify-center p-6" style="background-color: #0a1f0a;">
    <div class="w-full max-w-md">
        
        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="text-xl font-light text-white">Dashboard</h1>
            <p class="text-xs text-white/40 mt-0.5">{{ "now"|date("F j, Y") }}</p>
        </div>

        <!-- Profile Card -->
        <div class="glass-card p-4 mb-4">
            <div class="flex items-center gap-4">
                <!-- Avatar -->
                <div class="relative">
                    {% if app.user.profileImage %}
                        <img src="{{ app.user.profileImage }}" class="w-12 h-12 rounded-full border border-white/20 object-cover">
                    {% else %}
                        <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center">
                            <span class="text-lg text-white/80">{{ app.user.username|first|upper }}</span>
                        </div>
                    {% endif %}
                    <div class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-green-500 rounded-full border border-[#0a1f0a]"></div>
                </div>
                
                <div class="flex-1">
                    <h2 class="text-base font-medium text-white">{{ app.user.username }}</h2>
                    <p class="text-xs text-white/40">{{ app.user.email }}</p>
                    <div class="flex gap-1.5 mt-1">
                        {% if is_granted('ROLE_ADMIN') %}
                            <span class="text-xs px-1.5 py-0.5 bg-red-500/30 text-red-300 rounded text-[10px]">Admin</span>
                        {% elseif is_granted('ROLE_STAFF') %}
                            <span class="text-xs px-1.5 py-0.5 bg-blue-500/30 text-blue-300 rounded text-[10px]">Staff</span>
                        {% else %}
                            <span class="text-xs px-1.5 py-0.5 bg-green-500/30 text-green-300 rounded text-[10px]">User</span>
                        {% endif %}
                        <span class="text-xs px-1.5 py-0.5 bg-white/10 text-white/50 rounded text-[10px] capitalize">{{ app.user.status }}</span>
                    </div>
                </div>
                
                <a href="{{ path('app_profile_edit') }}" class="p-1.5 rounded-full bg-white/5 hover:bg-white/10 transition">
                    <img src="/images/svg/edit_1.svg" class="w-3 h-3 icon-white opacity-60" alt="Edit">
                </a>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="grid grid-cols-3 gap-2 mb-4">
            <div class="stat-box p-2 text-center">
                <p class="text-lg font-semibold text-white">{{ app.user.id }}</p>
                <p class="text-[10px] text-white/40">ID</p>
            </div>
            <div class="stat-box p-2 text-center">
                <p class="text-lg font-semibold text-white">{{ app.user.orders|length }}</p>
                <p class="text-[10px] text-white/40">Orders</p>
            </div>
            <div class="stat-box p-2 text-center">
                <p class="text-lg font-semibold text-white">{{ app.user.dateCreated|date('M j') }}</p>
                <p class="text-[10px] text-white/40">Joined</p>
            </div>
        </div>

        <!-- Role Message -->
        <div class="glass-card p-3 mb-4">
            <div class="flex items-center gap-2">
                {% if is_granted('ROLE_ADMIN') %}
                    <img src="/images/svg/dashboard.svg" class="w-3 h-3 icon-white opacity-50" alt="Admin">
                    <p class="text-[11px] text-white/50">Administrator access</p>
                {% elseif is_granted('ROLE_STAFF') %}
                    <img src="/images/svg/user.svg" class="w-3 h-3 icon-white opacity-50" alt="Staff">
                    <p class="text-[11px] text-white/50">Staff management access</p>
                {% else %}
                    <img src="/images/svg/account.svg" class="w-3 h-3 icon-white opacity-50" alt="User">
                    <p class="text-[11px] text-white/50">Standard user access</p>
                {% endif %}
            </div>
        </div>

        <!-- Actions -->
        <div class="grid grid-cols-2 gap-2">
            <a href="{{ path('app_profile') }}" class="flex items-center justify-center gap-1.5 px-3 py-2 bg-white/5 rounded-lg text-xs text-white/70 hover:bg-white/10 transition">
                <img src="/images/svg/account.svg" class="w-3 h-3 icon-white" alt="Profile">
                Profile
            </a>
            <a href="{{ path('app_order_index') }}" class="flex items-center justify-center gap-1.5 px-3 py-2 bg-white/5 rounded-lg text-xs text-white/70 hover:bg-white/10 transition">
                <img src="/images/svg/order_2.svg" class="w-3 h-3 icon-white" alt="Orders">
                Orders
            </a>
            <a href="{{ path('app_product') }}" class="flex items-center justify-center gap-1.5 px-3 py-2 bg-white/5 rounded-lg text-xs text-white/70 hover:bg-white/10 transition">
                <img src="/images/svg/product.svg" class="w-3 h-3 icon-white" alt="Products">
                Products
            </a>
            <a href="{{ path('app_logout') }}" class="flex items-center justify-center gap-1.5 px-3 py-2 bg-red-500/10 rounded-lg text-xs text-red-300/70 hover:bg-red-500/20 transition">
                <img src="/images/svg/logout.svg" class="w-3 h-3 icon-white" alt="Logout">
                Logout
            </a>
        </div>
    </div>
</div>
{% endblock %}