<!-- Contact Section -->
<section id="contact" class="w-full py-16" style="background: transparent;">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
        <div class="text-center mb-12">
            <h2 style="font-family: 'Cormorant Garamond', serif; font-weight: 300; color: #f0ede8; font-size: 2.8rem; letter-spacing: 0.05em;">Get In Touch</h2>
            <p style="color: #a89880;">We'd love to hear from you</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-12 mt-8" style="background: rgba(10, 18, 12, 0.6); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(201, 168, 76, 0.2); border-radius: 20px; padding: 3rem; box-shadow: 0 40px 100px rgba(0,0,0,0.5), inset 0 1px 0 rgba(201,168,76,0.1);">
            
            <!-- Contact Info -->
            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(201,168,76,0.15); border-radius: 16px; padding: 2rem;">
                <h3 style="font-family: 'Cormorant Garamond', serif; color: #e8d5a3; font-size: 1.6rem; font-weight: 400; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(201,168,76,0.2);">Visit Our Showroom</h3>
                
                <div class="flex items-center gap-4 mb-6 transition-all hover:translate-x-1" style="color: #a89880;">
                    <span style="min-width:40px; height:40px; background: rgba(201,168,76,0.1); border: 1px solid rgba(201,168,76,0.3); border-radius: 50%; display:flex; align-items:center; justify-content:center;">📍</span>
                    <p style="color: #a89880; margin:0;">123 Gemstone Avenue, New York, NY 10001</p>
                </div>
                <div class="flex items-center gap-4 mb-6 transition-all hover:translate-x-1">
                    <span style="min-width:40px; height:40px; background: rgba(201,168,76,0.1); border: 1px solid rgba(201,168,76,0.3); border-radius: 50%; display:flex; align-items:center; justify-content:center;">📞</span>
                    <p style="color: #a89880; margin:0;">+1 (555) 123-4567</p>
                </div>
                <div class="flex items-center gap-4 mb-6 transition-all hover:translate-x-1">
                    <span style="min-width:40px; height:40px; background: rgba(201,168,76,0.1); border: 1px solid rgba(201,168,76,0.3); border-radius: 50%; display:flex; align-items:center; justify-content:center;">✉️</span>
                    <p style="color: #a89880; margin:0;">admingemz@gmail.com</p>
                </div>
                <div class="flex items-center gap-4 mb-6 transition-all hover:translate-x-1">
                    <span style="min-width:40px; height:40px; background: rgba(201,168,76,0.1); border: 1px solid rgba(201,168,76,0.3); border-radius: 50%; display:flex; align-items:center; justify-content:center;">🕒</span>
                    <p style="color: #a89880; margin:0;">Mon - Fri: 9:00 AM - 6:00 PM</p>
                </div>
            </div>

            <!-- Form / Login -->
            {% if app.user %}
                <form class="contact-form flex flex-col gap-4">
                    <div>
                        <label style="color: #a89880; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; font-family: 'Jost', sans-serif;">Name</label>
                        <input type="text" name="name" value="{{ app.user.username }}" readonly
                               style="width:100%; padding: 12px 16px; background: rgba(255,255,255,0.04); border: 1px solid rgba(201,168,76,0.2); border-radius: 10px; color: #f0ede8; margin-top: 6px; font-family: 'Jost', sans-serif;">
                    </div>
                    <div>
                        <label style="color: #a89880; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; font-family: 'Jost', sans-serif;">Email</label>
                        <input type="email" name="email" value="{{ app.user.email }}" readonly
                               style="width:100%; padding: 12px 16px; background: rgba(255,255,255,0.04); border: 1px solid rgba(201,168,76,0.2); border-radius: 10px; color: #f0ede8; margin-top: 6px; font-family: 'Jost', sans-serif;">
                    </div>
                    <input type="text" name="subject" placeholder="Subject"
                           style="width:100%; padding: 12px 16px; background: rgba(255,255,255,0.04); border: 1px solid rgba(201,168,76,0.2); border-radius: 10px; color: #f0ede8; font-family: 'Jost', sans-serif;" 
                           onfocus="this.style.borderColor='#c9a84c'" onblur="this.style.borderColor='rgba(201,168,76,0.2)'">
                    <textarea name="message" rows="4" placeholder="Your Message" required
                              style="width:100%; padding: 12px 16px; background: rgba(255,255,255,0.04); border: 1px solid rgba(201,168,76,0.2); border-radius: 10px; color: #f0ede8; font-family: 'Jost', sans-serif; resize: vertical;"
                              onfocus="this.style.borderColor='#c9a84c'" onblur="this.style.borderColor='rgba(201,168,76,0.2)'"></textarea>
                    <button type="submit"
                            style="width:100%; padding: 14px; background: transparent; border: 1px solid #c9a84c; border-radius: 10px; color: #c9a84c; font-family: 'Jost', sans-serif; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.8rem; cursor: pointer; transition: all 0.3s ease;"
                            onmouseover="this.style.background='rgba(201,168,76,0.1)'; this.style.boxShadow='0 0 20px rgba(201,168,76,0.2)'"
                            onmouseout="this.style.background='transparent'; this.style.boxShadow='none'">
                        Send Message →
                    </button>
                </form>
            {% else %}
                <div class="text-center py-8">
                    <svg class="w-16 h-16 mx-auto mb-4" style="color: rgba(201,168,76,0.4);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <p style="color: #a89880; margin-bottom: 1.5rem; font-family: 'Jost', sans-serif;">Please login to send us a message</p>
                    <a href="{{ path('app_login') }}"
                       style="display: inline-block; padding: 12px 32px; background: transparent; border: 1px solid #c9a84c; border-radius: 50px; color: #c9a84c; font-family: 'Jost', sans-serif; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.8rem; text-decoration: none; transition: all 0.3s ease;"
                       onmouseover="this.style.background='rgba(201,168,76,0.1)'"
                       onmouseout="this.style.background='transparent'">
                        Login to Contact Us
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</section>


<!-- Footer -->
<footer class="w-full bg-[#014421] text-white text-center py-8">
    <p>© {{ "now"|date("Y") }} Gemz Crystalline. All rights reserved.</p>
    <p class="text-[#C8D8B8] text-sm mt-2">Timeless elegance for every occasion</p>
</footer>

<script>
let showingAll = false;
let totalProducts = 0;
let currentCategory = 'all';

window.onload = function() {
    totalProducts = document.querySelectorAll('.product-card').length;
    const totalCountElem = document.getElementById('total-count');
    if (totalCountElem) totalCountElem.textContent = totalProducts;
    initializeProductDisplay();
}

function initializeProductDisplay() {
    const products = document.querySelectorAll('.product-card');
    let visibleCount = 0;
    
    products.forEach((product, index) => {
        if (index < 4) {
            product.style.display = 'block';
            visibleCount++;
        } else {
            product.style.display = 'none';
        }
    });
    
    document.getElementById('visible-count').textContent = visibleCount;
    
    const showMoreContainer = document.getElementById('show-more-container');
    if (showMoreContainer) {
        if (totalProducts <= 4) {
            showMoreContainer.style.display = 'none';
        } else {
            showMoreContainer.style.display = 'block';
        }
    }
}

function filterProducts(category, event) {
    currentCategory = category;
    const products = document.querySelectorAll('.product-card');
    const filterBtns = document.querySelectorAll('.filter-btn');
    let categoryCount = 0;
    
    filterBtns.forEach(btn => {
        btn.classList.remove('active', 'bg-[#014421]', 'text-white');
        btn.classList.add('border-2', 'border-[#014421]', 'text-[#014421]');
    });
    
    event.target.classList.add('active', 'bg-[#014421]', 'text-white');
    event.target.classList.remove('border-2', 'border-[#014421]', 'text-[#014421]');
    
    products.forEach(product => {
        const productCategories = product.dataset.category.split(' ');
        if (category === 'all' || productCategories.includes(category)) {
            categoryCount++;
        }
    });
    
    showingAll = false;
    const btn = document.getElementById('show-more-btn');
    if (btn) {
        btn.innerHTML = '<span>Show More Products</span> <span class="text-xl">↓</span>';
    }
    
    let shownInCategory = 0;
    let visibleCount = 0;
    
    products.forEach(product => {
        const productCategories = product.dataset.category.split(' ');
        if (category === 'all' || productCategories.includes(category)) {
            if (shownInCategory < 4) {
                product.style.display = 'block';
                visibleCount++;
            } else {
                product.style.display = 'none';
            }
            shownInCategory++;
        } else {
            product.style.display = 'none';
        }
    });
    
    document.getElementById('visible-count').textContent = visibleCount;
    document.getElementById('total-count').textContent = categoryCount;
    
    const showMoreContainer = document.getElementById('show-more-container');
    if (showMoreContainer) {
        if (categoryCount <= 4) {
            showMoreContainer.style.display = 'none';
        } else {
            showMoreContainer.style.display = 'block';
        }
    }
}

function toggleProducts() {
    showingAll = !showingAll;
    const btn = document.getElementById('show-more-btn');
    if (btn) {
        btn.innerHTML = showingAll ? '<span>Show Less</span> <span class="text-xl">↑</span>' : '<span>Show More Products</span> <span class="text-xl">↓</span>';
    }
    filterProductsWithCategory(currentCategory, showingAll);
}

function filterProductsWithCategory(category, showAll) {
    const products = document.querySelectorAll('.product-card');
    let visibleCount = 0;
    let categoryCount = 0;
    
    products.forEach(product => {
        const productCategories = product.dataset.category.split(' ');
        if (category === 'all' || productCategories.includes(category)) {
            categoryCount++;
        }
    });
    
    let shownInCategory = 0;
    products.forEach(product => {
        const productCategories = product.dataset.category.split(' ');
        if (category === 'all' || productCategories.includes(category)) {
            if (showAll || shownInCategory < 4) {
                product.style.display = 'block';
                visibleCount++;
            } else {
                product.style.display = 'none';
            }
            shownInCategory++;
        } else {
            product.style.display = 'none';
        }
    });
    
    document.getElementById('visible-count').textContent = visibleCount;
    document.getElementById('total-count').textContent = categoryCount;
    
    const showMoreContainer = document.getElementById('show-more-container');
    if (showMoreContainer) {
        if (categoryCount <= 4) {
            showMoreContainer.style.display = 'none';
            showingAll = false;
        } else {
            showMoreContainer.style.display = 'block';
        }
    }
}

document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('href');
        if (targetId === '#') return;
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
            targetElement.scrollIntoView({behavior: 'smooth', block: 'start'});
            document.querySelectorAll('.nav-link').forEach(link => link.classList.remove('active'));
            this.classList.add('active');
        }
    });
});

window.addEventListener('scroll', () => {
    const sections = document.querySelectorAll('section');
    const navLinks = document.querySelectorAll('.nav-link');
    let current = '';
    sections.forEach(section => {
        const sectionTop = section.offsetTop;
        if (window.scrollY >= (sectionTop - 200)) current = section.getAttribute('id');
    });
    navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${current}`) link.classList.add('active');
    });
});

document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('.contact-form');
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            const submitBtn = this.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = 'Sending...';
            submitBtn.disabled = true;
            
            const formData = new FormData(this);
            const data = {
                name: formData.get('name'),
                email: formData.get('email'),
                subject: formData.get('subject') || 'No subject',
                message: formData.get('message')
            };
            
            if (!data.name || !data.email || !data.message) {
                showFeedback('Please fill in all required fields.', 'error');
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
                return;
            }
            
            try {
                const response = await fetch('/api/contact', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (response.ok) {
                    showFeedback('✅ Message sent successfully!', 'success');
                    this.reset();
                } else {
                    showFeedback('❌ Failed: ' + (result.error || 'Try again'), 'error');
                }
            } catch (err) {
                showFeedback('❌ Network error. Check connection.', 'error');
            } finally {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });
    }
});

function showFeedback(message, type) {
    const existing = document.querySelector('.contact-feedback');
    if (existing) existing.remove();
    const feedback = document.createElement('div');
    feedback.className = `contact-feedback mt-4 p-3 rounded-lg text-center ${type === 'success' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`;
    feedback.innerHTML = message;
    const form = document.querySelector('.contact-form');
    if (form) form.parentNode.insertBefore(feedback, form.nextSibling);
    setTimeout(() => {
        feedback.style.opacity = '0';
        setTimeout(() => feedback.remove(), 300);
    }, 5000);
}
</script>
</body>
</html>