                <div class="w-12 h-12 mx-auto mb-4" style="background-color: #ffffff; -webkit-mask: url('/images/svg/care.svg') no-repeat center / contain; mask: url('/images/svg/care.svg') no-repeat center / contain;"></div>
                <h3 class="text-[#014421] mb-2">Handcrafted with Care</h3>
