<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/icon/crystal1.ico" type="image/x-icon">
    <title>Gemz Crystalline</title>
    <link rel="stylesheet" href="/build/app.css">
</head>
<body>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=Jost:wght@300;400;500&display=swap');

    :root {
        --gold: #c9a84c;
        --gold-light: #e8d5a3;
        --glass-bg: rgba(255, 255, 255, 0.04);
        --glass-border: rgba(201, 168, 76, 0.2);
        --glass-card: rgba(255, 255, 255, 0.06);
        --text-primary: #f0ede8;
        --text-muted: #a89880;
    }

    * { box-sizing: border-box; }

    body {
        background: 
            radial-gradient(ellipse at 20% 50%, rgba(1, 68, 33, 0.4) 0%, transparent 60%),
            radial-gradient(ellipse at 80% 20%, rgba(201, 168, 76, 0.08) 0%, transparent 50%),
            linear-gradient(160deg, #0a0a0a 0%, #0d1f12 50%, #000000 100%);
        min-height: 100vh;
        font-family: 'Jost', sans-serif;
    }

    /* ── Main container ── */
    .max-w-6xl.mx-auto.px-\[5\%\].py-8 {
        background: rgba(10, 18, 12, 0.6) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid var(--glass-border) !important;
        box-shadow: 
            0 0 0 1px rgba(0,0,0,0.5),
            0 40px 100px rgba(0, 0, 0, 0.7),
            inset 0 1px 0 rgba(201, 168, 76, 0.15) !important;
    }

    /* ── Section headings ── */
    .max-w-6xl h2 {
        font-family: 'Cormorant Garamond', serif !important;
        font-weight: 300 !important;
        letter-spacing: 0.05em !important;
        color: var(--text-primary) !important;
    }

    .max-w-6xl h3, .max-w-6xl h4 {
        font-family: 'Cormorant Garamond', serif !important;
        color: var(--gold-light) !important;
        font-weight: 400 !important;
    }

    .max-w-6xl p, .max-w-6xl span:not(.absolute):not(.font-bold) {
        color: var(--text-muted) !important;
    }

    /* ── Product cards ── */
    .product-card {
        background: var(--glass-card) !important;
        backdrop-filter: blur(10px) !important;
        border: 1px solid var(--glass-border) !important;
        box-shadow: 0 8px 32px rgba(0,0,0,0.4) !important;
        transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease !important;
    }

    .product-card:hover {
        transform: translateY(-8px) !important;
        border-color: var(--gold) !important;
        box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 20px rgba(201,168,76,0.1) !important;
    }

    .product-card h3 {
        color: var(--text-primary) !important;
        font-family: 'Cormorant Garamond', serif !important;
        font-size: 1.1rem !important;
    }

    .product-card .font-bold {
        color: var(--gold) !important;
        font-family: 'Jost', sans-serif !important;
        letter-spacing: 0.05em !important;
    }

    .product-card p { color: var(--text-muted) !important; }

    /* Image sizing fix */
    .product-card > div:first-child {
        height: 192px !important;
        overflow: hidden !important;
    }
    .product-card img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        transition: transform 0.6s ease !important;
    }
    .product-card:hover img { transform: scale(1.08) !important; }

    /* ── Filter buttons ── */
    .filter-btn {
        border-color: rgba(201, 168, 76, 0.3) !important;
        color: var(--text-muted) !important;
        background: transparent !important;
        font-family: 'Jost', sans-serif !important;
        letter-spacing: 0.08em !important;
        font-size: 0.75rem !important;
        text-transform: uppercase !important;
        transition: all 0.3s ease !important;
    }
    .filter-btn:hover {
        border-color: var(--gold) !important;
        color: var(--gold) !important;
    }
    .filter-btn.active {
        background: linear-gradient(135deg, #014421, #012a15) !important;
        border-color: var(--gold) !important;
        color: var(--gold-light) !important;
        box-shadow: 0 0 15px rgba(201,168,76,0.15) !important;
    }

    /* ── Why Us cards ── */
    #why .grid > div {
        background: var(--glass-card) !important;
        backdrop-filter: blur(10px) !important;
        border: 1px solid var(--glass-border) !important;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3) !important;
        transition: transform 0.3s ease, border-color 0.3s ease !important;
    }
    #why .grid > div:hover {
        border-color: var(--gold) !important;
        transform: translateY(-6px) !important;
    }
    #why h3 { color: var(--gold-light) !important; }
    #why p  { color: var(--text-muted) !important; }

    /* ── About section ── */
    #about {
        background: rgba(5, 15, 8, 0.5) !important;
        border: 1px solid var(--glass-border) !important;
        backdrop-filter: blur(10px) !important;
    }
    #about h2, #about h3 { color: var(--text-primary) !important; }
    #about p { color: var(--text-muted) !important; }

    /* Team cards */
    #about .grid > div {
        background: var(--glass-card) !important;
        border: 1px solid var(--glass-border) !important;
        backdrop-filter: blur(8px) !important;
        transition: transform 0.3s ease, border-color 0.3s ease !important;
    }
    #about .grid > div:hover {
        border-color: var(--gold) !important;
        transform: translateY(-6px) !important;
    }
    #about h4 { color: var(--gold-light) !important; }
    #about span { color: var(--text-muted) !important; background: rgba(201,168,76,0.08) !important; }

    /* ── Divider accent ── */
    .text-center.mb-12::after {
        content: '';
        display: block;
        width: 60px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
        margin: 12px auto 0;
    }

    /* ── Show more button ── */
    #show-more-btn {
        background: transparent !important;
        border: 1px solid var(--gold) !important;
        color: var(--gold) !important;
        font-family: 'Jost', sans-serif !important;
        letter-spacing: 0.1em !important;
        text-transform: uppercase !important;
        font-size: 0.75rem !important;
        transition: all 0.3s ease !important;
    }
    #show-more-btn:hover {
        background: rgba(201,168,76,0.1) !important;
        box-shadow: 0 0 20px rgba(201,168,76,0.2) !important;
    }

    html {
        scroll-behavior: smooth;
        scroll-padding-top: 80px;
    }
    * {
        font-family: 'Jost', sans-serif !important;
    }

    .max-w-6xl h2,
    .max-w-6xl h3,
    .max-w-6xl h4,
    #contact h2,
    #contact h3 {
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        color: #ffffff !important;
    }

    .max-w-6xl p,
    .max-w-6xl span:not(.absolute):not(.font-bold),
    #contact p {
        color: #ffffff !important;
    }
</style>
<!-- Navigation with active state -->
<nav class="bg-[#014421] sticky top-0 z-50 px-[5%] py-4 flex justify-between items-center shadow-lg">
    <img src="/images/gemtitle-w.webp" alt="Gemz Crystalline" 
         class="h-10 w-auto"
         style="transform: scale(1.6) translateY(-2px); transform-origin: left center;">
    <div class="flex gap-8 items-center">
        <a href="#home" class="text-white no-underline opacity-100 hover:opacity-80 transition-opacity border-b-2 border-[#C8D8B8] pb-1">Home</a>
        <a href="#products" class="text-white no-underline opacity-100 hover:opacity-80 transition-opacity">Products</a>
        <a href="#why" class="text-white no-underline opacity-100 hover:opacity-80 transition-opacity">Why Us</a>
        <a href="#about" class="text-white no-underline opacity-100 hover:opacity-80 transition-opacity">About</a>
        <a href="#contact" class="text-white no-underline opacity-100 hover:opacity-80 transition-opacity">Contact</a>
        <a href="/login" class="bg-[#C8D8B8] text-[#014421] px-6 py-2 rounded-full font-semibold">Login</a>
    </div>
</nav>

<!-- MAIN BANNER SECTION -->
<section id="home" class="relative overflow-hidden w-full">
    <div class="absolute inset-0" style="background: linear-gradient(135deg, #014421 50%, #2D6A4F 50%);"></div>
    <div class="relative z-10 w-full h-[500px] bg-cover bg-center" 
         style="background-image: url('/images/misc/banner-3.png'); background-size: 150%; background-position: left center;">
        <div class="flex flex-col md:flex-row w-full h-full">
            <div class="flex-1 h-full flex items-center justify-center text-white">
                <div class="text-center md:text-left p-6">
                    <h1 class="text-4xl md:text-5xl font-bold leading-tight">
                        Timeless Elegance,<br>Modern Convenience
                    </h1>
                    <p class="text-[#E6E8D3] text-lg mt-4 max-w-md">
                        Discover authentic gemstones and handcrafted jewelry, delivered to your doorstep.
                    </p>
                    {% if app.user %}
                        <a href="{{ path('app_product') }}" class="inline-block bg-[#C8D8B8] text-[#014421] px-8 py-3 rounded-full font-semibold mt-6 hover:bg-white transition-colors">
                            Shop Now →
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="inline-block bg-[#C8D8B8] text-[#014421] px-8 py-3 rounded-full font-semibold mt-6 hover:bg-white transition-colors">
                            Shop Now!
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="flex-1 h-full flex items-center justify-center">
                <img src="/images/misc/banner-1.png" alt="Right" class="w-[63%] h-auto object-contain">
            </div>
        </div>
    </div>
</section>

<div class="max-w-6xl mx-auto px-[5%] py-8" style="border-radius: 30px; margin: 20px auto;">
