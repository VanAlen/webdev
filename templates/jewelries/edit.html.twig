{% extends 'base.html.twig' %}

{% block title %}Edit Jewelry{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-20">
  <div class="container mx-auto px-4">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">Edit Jewelry</h1>

    <div class="bg-white shadow-md rounded-lg p-6 flex flex-col md:flex-row md:space-x-10">
      <!-- Image Preview -->
    <!-- Image Preview -->
      <div class="md:w-1/3 flex justify-center items-center mb-8 md:mb-0">
        {% if jewelry.image %}
        <img src="{{ asset(jewelry.image? 'images/jewelries/' ~ jewelry.image: 'images/default-gem.webp') }}"
     alt="{{ jewelry.name }}"class="w-[500px] h-auto object-cover rounded-lg shadow-md">

        {% else %}
          <img src="{{ asset('images/default-jewelry.webp') }}" alt="No image" class="w-[500px] h-auto object-cover rounded-lg shadow-md opacity-50">
        {% endif %}
      </div>


      <!-- Form -->
      <div class="md:w-2/3 text-forest">
        {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data' } }) }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-forest">
          {{ form_row(form.name) }}
          {{ form_row(form.gemtype) }}
          {{ form_row(form.jewelrytype) }}
          {{ form_row(form.price) }}
          {{ form_row(form.stock) }}
          {{ form_row(form.image) }}
        </div>

        <div class="mt-6 flex flex-wrap gap-4">
                  <div class="mt-8 flex flex-wrap gap-4">
          <button type="submit"
                  class="px-5 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
            Update
          </button>
          <a href="{{ path('app_jewelries_index') }}" class="px-5 py-2 bg-gray-500 text-white rounded hover:bg-gray-600">Back to list</a>
          <form method="post" action="{{ path('app_jewelries_delete', {'id': jewelry.id}) }}" onsubmit="return confirm('Are you sure?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ jewelry.id) }}">
            <button type="submit" class="px-5 py-2 bg-red-600 text-white rounded hover:bg-red-700">Delete</button>
          </form>
        </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>
{% endblock %}
