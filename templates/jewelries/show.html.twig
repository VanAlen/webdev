{% extends 'base.html.twig' %}

{% block title %}Jewelry Details{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-20">
  <div class="container mx-auto px-4">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">Jewelry Details</h1>

    <div class="bg-white shadow-lg rounded-xl p-8 flex flex-col md:flex-row md:space-x-10 text-forest">
      <!-- Image -->
      <div class="md:w-1/3 flex justify-center items-center mb-8 md:mb-0 text-forest">
        {% if jewelry.image %}
            <img src="{{ asset(jewelry.image) }}" alt="{{ jewelry.name }}" class="w-[500px] h-auto object-cover rounded-lg shadow-md">
        {% else %}
            <img src="{{ asset('images/default-gem.webp') }}" alt="{{ jewelry.name }}" class="w-[500px] h-auto object-cover rounded-lg shadow-md">
        {% endif %}
      </div>

      <!-- Info -->
      <div class="md:w-2/3 text-forest">
        <table class="w-full text-sm md:text-base text-forest">
          <tbody class="text-forest">
            {% for label, value in {
              'ID': jewelry.id,
              'Name': jewelry.name,
              'Gem Type': jewelry.gemtype.name,
              'Jewelry Type': jewelry.jewelrytype.name,
              'Price': jewelry.price,
              'Stock': jewelry.stock
            } %}
              <tr class="border-b">
                <th class="py-3 px-4 text-gray-500 font-medium w-1/3">{{ label }}</th>
                <td class="py-3 px-4">{{ value }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <!-- Actions -->
        <div class="mt-8 flex flex-wrap gap-4">
            {# For GUESTS (no role, not logged in) #}
            {% if not app.user %}
                <a href="{{ path('app_landing') }}" class="px-5 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 flex items-center">
                    Back to Browse
                </a>
            {% else %}
                {# For LOGGED IN USERS (has any role) #}
                <a href="{{ path('app_jewelries_index') }}" class="px-5 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 flex items-center">
                    Back to List
                </a>
            {% endif %}
            
            {# Edit and Delete buttons - optional: only show for staff/admin #}
            {% if is_granted('ROLE_STAFF') or is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_jewelries_edit', {'id': jewelry.id}) }}" class="px-5 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 flex items-center">
                    Edit
                </a>
                <form method="post" action="{{ path('app_jewelries_delete', {'id': jewelry.id}) }}" onsubmit="return confirm('Are you sure?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ jewelry.id) }}">
                    <button type="submit" class="px-5 py-2 bg-red-600 text-white rounded hover:bg-red-700 flex items-center">
                        Delete
                    </button>
                </form>
            {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
