{% extends 'base.html.twig' %}

{% block title %}Jewelry Details{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-20">
  <div class="container mx-auto px-4">
    <h1 class="text-4xl font-semibold text-gray-800 mb-10 text-left">Jewelry Details</h1>

    <div class="bg-white shadow-lg rounded-xl p-8 flex flex-col md:flex-row md:space-x-10">
      
      <!-- Image -->
      <div class="md:w-1/3 flex justify-center items-center mb-8 md:mb-0">
        {% if customjewelry.imagepath %}
                <img src="{{ asset(customjewelry.imagepath) }}" alt="Jewelry Image" class="w-48 h-48 object-cover rounded-lg">
            {% else %}
                <span class="text-gray-400 italic">No image available</span>
            {% endif %}
      </div>

      <!-- Info Table -->
      <div class="md:w-2/3">
        <table class="w-full text-sm md:text-base text-gray-700">
          <tbody>
            {% for label, value in {
              'ID': customjewelry.id,
              'Gem Type': customjewelry.gemtype,
              'Jewelry Type': customjewelry.jewelrytype,
              'Notes': customjewelry.notes
            } %}
              <tr class="border-b">
                <th class="py-3 px-4 text-gray-500 font-medium w-1/3">{{ label }}</th>
                <td class="py-3 px-4">{{ value }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <!-- Actions -->
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="{{ path('app_customjewelries_edit', {'id': customjewelry.id}) }}"
             class="px-5 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Edit</a>
          <a href="{{ path('app_customjewelries_index') }}"
             class="px-5 py-2 bg-gray-500 text-white rounded hover:bg-gray-600">Back to list</a>
          <form method="post"
                action="{{ path('app_customjewelries_delete', {'id': customjewelry.id}) }}"
                onsubmit="return confirm('Are you sure you want to delete this item?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customjewelry.id) }}">
            <button type="submit" class="px-5 py-2 bg-red-600 text-white rounded hover:bg-red-700">Delete</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
