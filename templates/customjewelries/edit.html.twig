{% extends 'base.html.twig' %}

{% block title %}Edit Custom Jewelry{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-20">
  <div class="container mx-auto px-4">
    <h1 class="text-4xl font-semibold text-gray-800 mb-10 text-left">Edit Custom Jewelry #{{ customjewelry.id }}</h1>

    <!-- Flash messages -->
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-4 px-4 py-2 rounded text-white {{ label == 'success' ? 'bg-green-500' : label == 'error' ? 'bg-red-500' : 'bg-blue-500' }}">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    <div class="bg-white shadow-lg rounded-xl p-8 flex flex-col md:flex-row md:space-x-10 text-forest">
      
      <!-- Current Image Preview -->
      <div class="md:w-1/3 mb-8 md:mb-0">
        <h3 class="text-lg font-semibold mb-4">Current Image</h3>
        {% if customjewelry.imagepath %}
          <img src="{{ asset(customjewelry.imagepath) }}" 
               alt="Current Jewelry Image" 
               class="w-64 h-64 object-cover rounded-lg border-2 border-gray-300">
          <p class="mt-2 text-sm text-gray-600">
            Current file: {{ customjewelry.imagepath|split('/')|last }}
          </p>
        {% else %}
          <div class="w-64 h-64 border-2 border-dashed border-gray-300 rounded-lg flex items-center justify-center">
            <span class="text-gray-400 italic">No image available</span>
          </div>
        {% endif %}
        
        <!-- Current Details -->
        <div class="mt-6 p-4 bg-gray-50 rounded">
          <h4 class="font-semibold mb-2">Current Details:</h4>
          <p><strong>Gem Type:</strong> {{ customjewelry.gemtype ? customjewelry.gemtype.name : 'Not set' }}</p>
          <p><strong>Jewelry Type:</strong> {{ customjewelry.jewelrytype ? customjewelry.jewelrytype.name : 'Not set' }}</p>
          <p><strong>Customer:</strong> {{ customjewelry.customer ? customjewelry.customer.username : 'Not set' }}</p>
          <p><strong>Created:</strong> {{ customjewelry.createdAt|date('Y-m-d H:i') }}</p>
        </div>
      </div>

      <!-- Form Fields -->
      <div class="md:w-2/3 text-forest">
        {{ form_start(form, { 
          'attr': { 
            'enctype': 'multipart/form-data',
            'class': 'space-y-6'
          } 
        }) }}

        {# Display form-level errors #}
        {{ form_errors(form) }}

        <div class="space-y-6">
          {{ form_row(form.gemtype, {
            'row_attr': {'class': 'mb-6'},
            'label': 'Gem Type',
            'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}
          }) }}
          
          {{ form_row(form.jewelrytype, {
            'row_attr': {'class': 'mb-6'},
            'label': 'Jewelry Type',
            'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}
          }) }}
          
          {{ form_row(form.notes, {
            'row_attr': {'class': 'mb-6'},
            'label': 'Notes',
            'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}
          }) }}
          
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Update Image (Optional)
            </label>
            <div class="p-4 border border-gray-300 rounded bg-gray-50">
              <p class="text-sm text-gray-600 mb-3">
                Leave empty to keep current image. Upload new image to replace.
              </p>
              {{ form_widget(form.imagepath, {
                'attr': {'class': 'w-full rounded-md border-gray-300 bg-white p-2'}
              }) }}
              {{ form_errors(form.imagepath) }}
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="mt-8 flex flex-wrap gap-4">
          <button type="submit" 
                  class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 font-medium">
            Update Changes
          </button>
          <a href="{{ path('app_customjewelries_show', {'id': customjewelry.id}) }}" 
             class="px-6 py-2 bg-gray-500 text-white rounded hover:bg-gray-600">
            Cancel
          </a>
          <form method="post"
                action="{{ path('app_customjewelries_delete', {'id': customjewelry.id}) }}"
                onsubmit="return confirm('Are you sure you want to delete this custom jewelry?');"
                class="inline">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customjewelry.id) }}">
            <button type="submit" 
                    class="px-6 py-2 bg-red-600 text-white rounded hover:bg-red-700">
              Delete
            </button>
          </form>
        </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>
{% endblock %}