{% extends 'base.html.twig' %}

{% block body %}
<div class="flex items-center justify-center min-h-screen" style="background-color:#FAF3A0;">
  <div class="bg-white shadow-lg rounded-xl p-8 w-full max-w-sm">
    <h1 class="text-2xl font-bold text-center mb-6" style="color:#014421;">
      Register
    </h1>

    {% for message in app.flashes('success') %}
      <div class="p-2 rounded mb-4" style="background-color:#014421; color:#FAF3A0;">
        {{ message }}
      </div>
    {% endfor %}

    <form method="post" class="space-y-4">
      <div>
        <label class="block text-sm font-medium" style="color:#014421;">Username:</label>
        <input type="text" name="username" required
               class="mt-1 block w-full rounded-md border shadow-sm px-2 py-1"
               style="border-color:#014421; focus:border:#014421;"/>
      </div>

      <button type="submit"
              class="w-full py-2 px-4 rounded-md font-semibold"
              style="background-color:#014421; color:#FAF3A0;">
        Register
      </button>
    </form>

    <p class="text-center text-sm mt-4" style="color:#014421;">
      Already have an account?
      <a href="{{ path('login') }}" style="color:#014421; font-weight:bold;">Log In</a>
    </p>
  </div>
</div>
{% endblock %}
