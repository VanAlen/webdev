{% extends 'base.html.twig' %}

{% block title %}User List{% endblock %}

{% block body %}
<style>
    .icon-white { filter: brightness(0) invert(1); }
    .table-container {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 1rem;
        overflow: hidden;
    }
    table th {
        background: rgba(255, 255, 255, 0.08);
        color: white;
        font-weight: 500;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    table td {
        color: white;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    table tr:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .role-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 50px;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin: 2px;
    }
    .role-admin  { background: rgba(201,168,76,0.15); border: 1px solid rgba(201,168,76,0.4); color: #e8d5a3; }
    .role-staff  { background: rgba(122,184,232,0.1); border: 1px solid rgba(122,184,232,0.3); color: #7ab8e8; }
    .role-user   { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); color: rgba(255,255,255,0.5); }
    .status-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 50px;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .status-active   { background: rgba(126,203,158,0.1); border: 1px solid rgba(126,203,158,0.3); color: #7ecb9e; }
    .status-inactive { background: rgba(232,122,122,0.1); border: 1px solid rgba(232,122,122,0.3); color: #e87a7a; }
    .pw-mask { font-family: monospace; color: rgba(255,255,255,0.25); letter-spacing: 0.1em; font-size: 0.75rem; }
</style>

<div class="min-h-screen p-6" style="background-color: #0a1f0a;">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-light text-white">User List</h1>
                <p class="text-sm text-white/50 mt-1">Manage accounts & permissions</p>
            </div>
            <a href="{{ path('app_user_new') }}" class="px-4 py-2 bg-white/10 rounded-xl text-sm text-white hover:bg-white/20 transition border border-white/20 flex items-center gap-2">
                <img src="/images/svg/add_2.svg" class="w-5 h-5 icon-white opacity-70 hover:opacity-100" alt="Add">
                New User
            </a>
        </div>

        <!-- Stats Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <!-- Total Users -->
            <div class="rounded-xl p-5" style="background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s ease;">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-white/60 uppercase tracking-wider">Total Users</p>
                        <p class="text-3xl font-bold text-white mt-1">{{ users|length }}</p>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Admins -->
            <div class="rounded-xl p-5" style="background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s ease;">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-white/60 uppercase tracking-wider">Admins</p>
                        <p class="text-3xl font-bold text-white mt-1" style="color: #e8d5a3;">{{ users|filter(u => 'ROLE_ADMIN' in u.roles)|length }}</p>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Staff -->
            <div class="rounded-xl p-5" style="background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s ease;">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-white/60 uppercase tracking-wider">Staff</p>
                        <p class="text-3xl font-bold text-white mt-1" style="color: #7ab8e8;">{{ users|filter(u => 'ROLE_STAFF' in u.roles)|length }}</p>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Active -->
            <div class="rounded-xl p-5" style="background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.2s ease;">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-white/60 uppercase tracking-wider">Active</p>
                        <p class="text-3xl font-bold text-white mt-1" style="color: #7ecb9e;">{{ users|filter(u => u.status == 'active')|length }}</p>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="table-container">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">ID</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Username</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Roles</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Password</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">Status</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-white/60 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                        <tr class="hover:bg-white/5 transition">
                            <td class="px-4 py-3 text-sm" style="color: #e8d5a3; font-weight:500;">#{{ user.id }}</td>
                            <td class="px-4 py-3 text-sm text-white">{{ user.username }}</td>
                            <td class="px-4 py-3">
                                {% for role in user.roles %}
                                    {% if role == 'ROLE_ADMIN' %}
                                        <span class="role-badge role-admin">Admin</span>
                                    {% elseif role == 'ROLE_STAFF' %}
                                        <span class="role-badge role-staff">Staff</span>
                                    {% elseif role == 'ROLE_USER' %}
                                        <span class="role-badge role-user">User</span>
                                    {% endif %}
                                {% endfor %}
                            </td>
                            <td class="px-4 py-3">
                                <span class="pw-mask">••••••••••••</span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="status-badge {{ user.status == 'active' ? 'status-active' : 'status-inactive' }}">
                                    {{ user.status }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="p-1 rounded hover:bg-white/10 transition" title="Edit">
                                        <img src="/images/svg/edit_1.svg" class="w-4 h-4 icon-white opacity-70 hover:opacity-100" alt="Edit">
                                    </a>
                                    <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Delete this user?');" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button type="submit" class="p-1 rounded hover:bg-white/10 transition" title="Delete">
                                            <img src="/images/svg/trash_4.svg" class="w-4 h-4 icon-white opacity-70 hover:opacity-100" alt="Delete">
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-white/40">
                                No users found.
                                <a href="{{ path('app_user_new') }}" class="text-white/60 hover:text-white underline">Create the first user</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}