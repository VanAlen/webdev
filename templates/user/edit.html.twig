{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
<style>
    .icon-white { filter: brightness(0) invert(1); }
    .glass-card {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        transition: all 0.2s ease;
    }
    .form-input {
        width: 100%;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 0.75rem;
        color: white;
        transition: all 0.2s ease;
    }
    .form-input:focus {
        outline: none;
        border-color: rgba(255, 255, 255, 0.3);
        background: rgba(255, 255, 255, 0.1);
    }
    .form-input option {
        background: #0a1f0a;
    }
    .form-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 0.5rem;
    }
    .radio-group {
        display: flex;
        gap: 1.5rem;
        padding: 0.5rem 0;
    }
    .radio-group label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: white;
        cursor: pointer;
    }
    .radio-group input[type="radio"] {
        accent-color: #0a1f0a;
    }
    select.form-input {
        cursor: pointer;
    }
</style>

<div class="min-h-screen p-6" style="background-color: #0a1f0a;">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-light text-white">Edit User</h1>
                <p class="text-sm text-white/50 mt-1">{{ user.username }}</p>
            </div>
            <a href="{{ path('app_user_index') }}" class="px-4 py-2 bg-white/10 rounded-xl text-sm text-white hover:bg-white/20 transition border border-white/20 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Back to List
            </a>
        </div>

        <!-- Flash Messages -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 px-4 py-3 rounded-xl {{ label == 'success' ? 'bg-green-500/20 border border-green-500/30 text-green-300' : 'bg-red-500/20 border border-red-500/30 text-red-300' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Main Card -->
        <div class="glass-card p-8">
            <!-- User Information Display -->
            <div class="mb-8 pb-6 border-b border-white/10">
                <h2 class="text-lg font-semibold text-white mb-4">User Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-xs text-white/60 uppercase tracking-wider">ID</p>
                        <p class="text-white font-medium mt-1">{{ user.id }}</p>
                    </div>
                    <div>
                        <p class="text-xs text-white/60 uppercase tracking-wider">Username</p>
                        <p class="text-white font-medium mt-1">{{ user.username }}</p>
                    </div>
                    <div>
                        <p class="text-xs text-white/60 uppercase tracking-wider">Date Created</p>
                        <p class="text-white font-medium mt-1">{{ user.dateCreated|date('Y-m-d H:i:s') }}</p>
                    </div>
                    <div>
                        <p class="text-xs text-white/60 uppercase tracking-wider">Status</p>
                        <p class="text-white font-medium mt-1">{{ user.status|capitalize }}</p>
                    </div>
                </div>
            </div>

            <!-- Edit Form -->
            <div>
                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                <!-- Username -->
  <div class="grid grid-cols-2 gap-3">
    <div>
        {{ form_label(form.username, 'Username', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.username, {'attr': {'class': 'form-input'}}) }}
        {{ form_errors(form.username) }}
    </div>
    <div>
        {{ form_label(form.plainPassword, 'Password', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.plainPassword, {'attr': {'class': 'form-input', 'placeholder': 'Leave blank to keep current password'}}) }}
        {{ form_errors(form.plainPassword) }}
    </div>
    <div>
        {{ form_label(form.roles, 'Role', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.roles, {'attr': {'class': 'form-input'}}) }}
        {{ form_errors(form.roles) }}
    </div>
    <div>
        {{ form_label(form.status, 'Status', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.status, {'attr': {'class': 'form-input'}}) }}
        {{ form_errors(form.status) }}
    </div>
</div>

                <!-- Actions -->
                <div class="pt-6 border-t border-white/10">
                    <div class="flex justify-between items-center">
                        <a href="{{ path('app_user_index') }}" class="px-6 py-2 bg-white/10 rounded-xl text-sm text-white hover:bg-white/20 transition">
                            Cancel
                        </a>
                        <div class="flex gap-3">
                            <button type="reset" class="px-6 py-2 bg-red-500/20 border border-red-500/30 rounded-xl text-sm text-red-300 hover:bg-red-500/30 transition">
                                Reset
                            </button>
                            <button type="submit" class="px-6 py-2 bg-white/20 rounded-xl text-sm text-white hover:bg-white/30 transition flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Save Changes
                            </button>
                        </div>
                    </div>
                </div>

                {{ form_end(form) }}

                <!-- Delete Section --><!-- Delete -->
                <div style="border-top: 1px solid rgba(255,255,255,0.08);" class="mt-5 pt-4">
            
                    
                    <button type="button" onclick="document.getElementById('delete-modal').classList.remove('hidden')"
                        class="px-4 py-1.5 bg-red-500/20 rounded-lg text-xs text-red-300 hover:bg-red-500/30 transition">
                        Delete User
                    </button>
                    <p class="text-xs text-white mt-1.5 py-2">This permanently deletes the account.</p>
                </div>

                <!-- Delete Modal -->
                <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
                    <div style="background: #0f2a0f; border: 1px solid rgba(255,255,255,0.12); border-radius: 1rem; padding: 1.5rem; width: 100%; max-width: 360px;">
                        
                        <div class="flex items-center gap-3 mb-3">
                            <div class="flex items-center justify-center w-9 h-9 rounded-full bg-red-500/20 border border-red-500/30">
                                <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="text-white text-sm font-medium">Delete user?</p>
                                <p class="text-white/40 text-xs">{{ user.username }}</p>
                            </div>
                        </div>

                        <p class="text-white/50 text-xs mb-4 leading-relaxed">
                            This will permanently delete the account and all associated data. This action cannot be undone.
                        </p>

                        <div class="flex gap-2 justify-end">
                            <button type="button" onclick="document.getElementById('delete-modal').classList.add('hidden')"
                                class="px-4 py-1.5 bg-white/10 border border-white/20 rounded-lg text-xs text-white/70 hover:bg-white/20 transition">
                                Cancel
                            </button>
                            <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button type="submit"
                                    class="px-4 py-1.5 bg-red-500/30 border border-red-500/40 rounded-lg text-xs text-red-300 hover:bg-red-500/40 transition">
                                    Yes, delete
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}