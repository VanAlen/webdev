{% extends 'base.html.twig' %}

{% block title %}Create New User{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col">
  <div class="container mx-auto px-4 py-10 flex-1">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-black">Create New User</h1>
      <a href="{{ path('app_user_index') }}" 
         class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition duration-200 flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to List
      </a>
    </div>

    <div class="bg-white shadow-xl rounded-xl p-8 border border-gray-200">
      {% for label, messages in app.flashes %}
        {% for message in messages %}
          <div class="mb-6 px-4 py-3 rounded-lg {{ label == 'success' ? 'bg-green-600 text-white' : 'bg-red-600 text-white' }} shadow-md">
            {{ message }}
          </div>
        {% endfor %}
      {% endfor %}

      {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="space-y-4">
          <div class="form-group">
            {{ form_label(form.username, null, {'label_attr': {'class': 'block text-black font-medium mb-2'}}) }}
            {{ form_widget(form.username, {'attr': {
              'class': 'w-full px-4 py-3 bg-gray-100 text-black rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200'
            }}) }}
            {{ form_errors(form.username) }}
          </div>

          <div class="form-group">
            {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'block text-black font-medium mb-2'}}) }}
            {{ form_widget(form.plainPassword, {'attr': {
              'class': 'w-full px-4 py-3 bg-gray-100 text-black rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200'
            }}) }}
            {{ form_errors(form.plainPassword) }}
          </div>
        </div>

        <div class="space-y-4">
          <div class="form-group">
            {{ form_label(form.roles, null, {'label_attr': {'class': 'block text-black font-medium mb-2'}}) }}
            <div class="bg-gray-100 p-4 rounded-lg border border-gray-300">
              {{ form_widget(form.roles, {'attr': {
                'class': 'space-y-2 text-black'
              }}) }}
            </div>
            {{ form_errors(form.roles) }}
          </div>

          <div class="form-group">
            {{ form_label(form.status, null, {'label_attr': {'class': 'block text-black font-medium mb-2'}}) }}
            {{ form_widget(form.status, {'attr': {
              'class': 'w-full px-4 py-3 bg-gray-100 text-black rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200'
            }}) }}
            {{ form_errors(form.status) }}
          </div>
        </div>
      </div>

      <div class="pt-6 border-t border-gray-300">
        <div class="flex justify-between items-center">
          <!-- Left: Back button -->
          <a href="{{ path('app_user_index') }}"
             class="px-6 py-3 bg-gray-200 text-gray-800 font-medium rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 transition duration-200 shadow-sm">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to List
          </a>
          
          <!-- Right: Reset and Create buttons -->
          <div class="flex space-x-4">
            <button type="reset" class="px-6 py-3 bg-red-600 text-white font-medium rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition duration-200 shadow-sm">
              Reset
            </button>
            <button type="submit" class="px-6 py-3 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition duration-200 shadow-sm flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              Create User
            </button>
          </div>
        </div>
      </div>

      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}