<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email | Gemz Crystalline</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        .header {
            background: linear-gradient(135deg, #014421 0%, #2D6A4F 100%);
            padding: 40px 30px;
            text-align: center;
        }
        .header h1 {
            color: white;
            margin: 0;
            font-size: 28px;
            letter-spacing: 1px;
        }
        .header p {
            color: #C8D8B8;
            margin: 10px 0 0;
        }
        .content {
            padding: 40px 30px;
        }
        .button {
            display: inline-block;
            background: #014421;
            color: white !important;
            padding: 14px 35px;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 600;
            margin: 20px 0;
            transition: background 0.3s;
        }
        .button:hover {
            background: #2D6A4F;
        }
        .link {
            background: #f4f4f4;
            padding: 12px;
            border-radius: 8px;
            word-break: break-all;
            font-size: 12px;
            color: #666;
            margin: 15px 0;
        }
        .footer {
            background: #f4f4f4;
            padding: 20px;
            text-align: center;
            font-size: 12px;
            color: #888;
        }
        hr {
            border: none;
            border-top: 1px solid #eee;
            margin: 25px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>💎 Gemz Crystalline</h1>
            <p>Timeless Elegance, Modern Convenience</p>
        </div>
        
        <div class="content">
            <h2 style="color: #014421; margin-top: 0;">Hello {{ user.username }}!</h2>
            
            <p style="color: #333; line-height: 1.6; font-size: 16px;">
                Thank you for registering with <strong>Gemz Crystalline</strong>. Please verify your email address to start exploring our authentic gemstones and handcrafted jewelry.
            </p>
            
            <div style="text-align: center;">
                <a href="{{ verificationUrl }}" class="button">
                    ✨ Verify Email Address ✨
                </a>
            </div>
            
            <p style="color: #666; font-size: 14px; text-align: center;">
                Or copy and paste this link into your browser:
            </p>
            <div class="link">
                {{ verificationUrl }}
            </div>
            
            <hr>
            
            <p style="color: #666; font-size: 13px; margin: 0;">
                This verification link will expire in 24 hours.<br>
                If you did not create an account with Gemz Crystalline, please ignore this email.
            </p>
        </div>
        
        <div class="footer">
            <p style="margin: 0;">&copy; {{ "now"|date("Y") }} Gemz Crystalline. All rights reserved.</p>
            <p style="margin: 5px 0 0;">Timeless elegance for every occasion</p>
        </div>
    </div>
</body>
</html>