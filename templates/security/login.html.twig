
{% block body %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Log in | Gemz Crystalline</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/build/app.css">
  <style>
    /* Line input styling */
    .line-input {
      background: transparent;
      border: none;
      border-bottom: 1.5px solid rgba(0, 0, 0, 0.15);
      border-radius: 0;
      padding: 0.5rem 0;
      padding-right: 2rem;
      transition: all 0.3s ease;
      font-size: 0.9rem;
    }

    .line-input:focus {
      outline: none;
      border-bottom-color: #014421;
      box-shadow: none;
    }

    .line-input::placeholder {
      color: rgba(0, 0, 0, 0.35);
      font-size: 0.9rem;
    }

    /* Password toggle button */
    .password-toggle {
      position: absolute;
      right: 0;
      bottom: 0.5rem;
      cursor: pointer;
      user-select: none;
      color: rgba(0, 0, 0, 0.35);
      transition: color 0.3s ease;
    }

    .password-toggle:hover {
      color: #014421;
    }

    .password-wrapper {
      position: relative;
      width: 100%;
    }

    /* Floating Toast Notification */
    .toast-notification {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 9999;
      animation: slideInRight 0.3s ease-out;
      max-width: 400px;
    }

    @keyframes slideInRight {
      from {
        transform: translateX(100%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }

    .toast-notification.hide {
      animation: slideOutRight 0.3s ease-out forwards;
    }

    @keyframes slideOutRight {
      from {
        transform: translateX(0);
        opacity: 1;
      }
      to {
        transform: translateX(100%);
        opacity: 0;
      }
    }

    .toast-success {
      background: #10b981;
      border-left: 4px solid #047857;
    }
    .toast-error {
      background: #ef4444;
      border-left: 4px solid #b91c1c;
    }
    .toast-warning {
      background: #f59e0b;
      border-left: 4px solid #d97706;
    }
    .toast-info {
      background: #3b82f6;
      border-left: 4px solid #1d4ed8;
    }
  </style>
</head>
<body class="m-0 p-0 overflow-hidden">

  <!-- Floating Toast Container -->
  <div id="toastContainer" class="toast-notification hidden">
    <div class="rounded-lg shadow-2xl text-white p-4 flex items-center justify-between min-w-[300px]">
      <div class="flex items-center space-x-3">
        <svg id="toastIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <p id="toastTitle" class="font-semibold">Title</p>
          <p id="toastMessage" class="text-sm opacity-90">Message</p>
        </div>
      </div>
      <button onclick="closeToast()" class="ml-4 hover:opacity-75">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- FULLSCREEN SPLIT LAYOUT - 60/40 RATIO -->
  <div class="flex h-screen w-screen">

    <!-- LEFT SIDE: Infographics (60%) -->
