{% extends 'base.html.twig' %}

{% block body %}
<div style="background-image: url('/images/misc/login.jpg'); background-size: cover; background-position: center; min-height: 100%; display: flex; align-items: flex-start; padding-top: 40px;">
    <div class="px-6 py-8 w-full">
        <!-- Profile Header - Horizontal Layout with Edit Button at Top Right -->
        <div class="flex justify-between items-start mb-8">
            <!-- Left: Profile Image + Info -->
            <div class="flex items-center gap-6">
                <!-- Profile Image -->
                <div class="relative inline-block group">
                    {% if user.profileImage %}
                        <img src="{{ user.profileImage }}" class="w-32 h-32 rounded-full border-4 border-white shadow-xl object-cover">
                    {% else %}
                        <img src="/images/svg/profile.svg" class="w-32 h-32 rounded-full border-4 border-white shadow-xl object-cover bg-white/20">
                    {% endif %}
                </div>
                
                <!-- Username, Role and Icons -->
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-3xl font-bold text-white">{{ user.username }}</h2>
                        {% if is_granted('ROLE_ADMIN') %}
                            <span class="text-xl">👑</span>
                        {% elseif is_granted('ROLE_STAFF') %}
                            <span class="text-xl">⭐</span>
                        {% else %}
                            <span class="text-xl">👤</span>
                        {% endif %}
                    </div>
                    <p class="text-white text-base">{{ user.email }}</p>
                    <div class="flex items-center gap-3 mt-2">
                        <div class="flex items-center gap-1">
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span class="text-xs text-white">
                                {% if is_granted('ROLE_ADMIN') %}Administrator
                                {% elseif is_granted('ROLE_STAFF') %}Staff
                                {% else %}User{% endif %}
                            </span>
                        </div>
                        <div class="w-px h-3 bg-white/30"></div>
                        <div class="flex items-center gap-1">
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span class="text-xs text-white capitalize">{{ user.status }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Edit Button at Top -->
            <a href="{{ path('app_profile_edit') }}" class="px-5 py-2 bg-white text-gray-800 rounded-lg hover:bg-green-500 hover:text-white transition font-medium flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                </svg>
                Edit Profile
            </a>
        </div>
        
        <!-- Stats - Horizontal with dividers -->
        <div class="flex items-center justify-start gap-8 mb-8">
            <div class="text-center">
                <p class="text-2xl font-bold text-white">{{ user.orders|length }}</p>
                <p class="text-xs text-white">Orders</p>
            </div>
            <div class="w-px h-8 bg-white/30"></div>
            <div class="text-center">
                <p class="text-2xl font-bold text-white">{{ user.dateCreated|date('Y') }}</p>
                <p class="text-xs text-white">Member</p>
            </div>
            <div class="w-px h-8 bg-white/30"></div>
            <div class="text-center">
                <p class="text-2xl font-bold text-white">{{ user.age ?: '—' }}</p>
                <p class="text-xs text-white">Age</p>
            </div>
        </div>

        <!-- Personal Info -->
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 mb-8">
            <h3 class="text-lg font-semibold mb-4 text-white">Personal Information</h3>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-sm text-white">First name</label>
                    <p class="text-white font-medium text-lg">{{ user.firstName ?: '—' }}</p>
                </div>
                <div>
                    <label class="text-sm text-white">Last name</label>
                    <p class="text-white font-medium text-lg">{{ user.lastName ?: '—' }}</p>
                </div>
                <div class="col-span-2">
                    <label class="text-sm text-white">Address</label>
                    <p class="text-white font-medium text-lg">{{ user.address ?: '—' }}</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}