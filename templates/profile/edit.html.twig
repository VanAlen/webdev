{% extends 'base.html.twig' %}

{% block body %}
<style>
    label {
        color: white !important;
    }
    .form-label {
        color: white !important;
    }
    select, option {
        color: white !important;
        background-color: transparent !important;
    }
    select option {
        background-color: #0a1f0a !important;
    }
</style>

<div style="background-image: url('/images/misc/login.jpg'); background-size: cover; background-position: center; min-height: 100vh; display: flex; align-items: flex-start; padding-top: 40px;">
    <div class="max-w-3xl mx-auto w-full px-6">
        <!-- Header -->
        <div class="mb-8">
            <h2 class="text-2xl font-semibold text-white">Edit Profile</h2>
            <p class="text-sm text-white mt-1">Update your personal information</p>
        </div>

        <!-- Form -->
        {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
            
            <!-- Row 1: First Name + Last Name -->
            <div class="grid grid-cols-2 gap-5">
                <div>
                    {{ form_label(form.firstName, 'First Name', {'label_attr': {'class': 'block text-sm text-white mb-1'}}) }}
                    {{ form_widget(form.firstName, {'attr': {'class': 'w-full px-0 py-2 text-base bg-transparent border-0 border-b border-white/30 text-white focus:border-white focus:ring-0 outline-none transition placeholder-white/50'}}) }}
                </div>
                <div>
                    {{ form_label(form.lastName, 'Last Name', {'label_attr': {'class': 'block text-sm text-white mb-1'}}) }}
                    {{ form_widget(form.lastName, {'attr': {'class': 'w-full px-0 py-2 text-base bg-transparent border-0 border-b border-white/30 text-white focus:border-white focus:ring-0 outline-none transition placeholder-white/50'}}) }}
                </div>
            </div>

            <!-- Row 2: Age + Address -->
            <div class="grid grid-cols-2 gap-5">
                <div>
                    {{ form_label(form.age, 'Age', {'label_attr': {'class': 'block text-sm text-white mb-1'}}) }}
                    {{ form_widget(form.age, {'attr': {'class': 'w-full px-0 py-2 text-base bg-transparent border-0 border-b border-white/30 text-white focus:border-white focus:ring-0 outline-none transition placeholder-white/50'}}) }}
                </div>
                <div>
                    {{ form_label(form.address, 'Address', {'label_attr': {'class': 'block text-sm text-white mb-1'}}) }}
                    {{ form_widget(form.address, {'attr': {'class': 'w-full px-0 py-2 text-base bg-transparent border-0 border-b border-white/30 text-white focus:border-white focus:ring-0 outline-none transition placeholder-white/50'}}) }}
                </div>
            </div>

            <!-- Row 3: Profile Image + Status (side by side) -->
            <div class="grid grid-cols-2 gap-5">
                <div>
                    {{ form_label(form.profileImageFile, 'Profile Image', {'label_attr': {'class': 'block text-sm text-white mb-1'}}) }}
                    {{ form_widget(form.profileImageFile, {'attr': {'class': 'w-full text-white file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:bg-white/10 file:text-white hover:file:bg-white/20'}}) }}
                    {% if user.profileImage %}
                        <div class="mt-2">
                            <img src="{{ user.profileImage }}" class="w-16 h-16 rounded-full object-cover">
                        </div>
                    {% endif %}
                </div>
                <div>
                    {% if form.status is defined %}
                        {{ form_label(form.status, 'Status', {'label_attr': {'class': 'block text-sm text-white mb-1'}}) }}
                        {{ form_widget(form.status, {'attr': {'class': 'w-full px-0 py-2 text-base bg-transparent border-0 border-b border-white/30 text-white focus:border-white focus:ring-0 outline-none'}}) }}
                    {% endif %}
                </div>
            </div>

            <!-- Admin Settings (only for admins editing other users) -->
            {% if is_granted('ROLE_ADMIN') and app.user.id != user.id %}
                <div class="pt-4">
                    <p class="text-xs font-semibold text-white uppercase tracking-wider mb-4">Admin Settings</p>
                    <div class="grid grid-cols-2 gap-5">
                        <div>
                            {{ form_label(form.username, 'Username', {'label_attr': {'class': 'block text-sm text-white mb-1'}}) }}
                            {{ form_widget(form.username, {'attr': {'class': 'w-full px-0 py-2 text-base bg-transparent border-0 border-b border-white/30 text-white focus:border-white focus:ring-0 outline-none placeholder-white/50'}}) }}
                        </div>
                        <div>
                            {{ form_label(form.email, 'Email', {'label_attr': {'class': 'block text-sm text-white mb-1'}}) }}
                            {{ form_widget(form.email, {'attr': {'class': 'w-full px-0 py-2 text-base bg-transparent border-0 border-b border-white/30 text-white focus:border-white focus:ring-0 outline-none placeholder-white/50'}}) }}
                        </div>
                        <div>
                            <label class="block text-sm text-white mb-1">Current Role</label>
                            <p class="text-white text-base py-2">
                                {% if 'ROLE_ADMIN' in user.roles %}👑 Administrator
                                {% elseif 'ROLE_STAFF' in user.roles %}⭐ Staff
                                {% else %}👤 User{% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- BUTTONS AT THE VERY BOTTOM -->
            <div class="flex gap-3 pt-6">
                <button type="submit" class="flex-1 bg-white text-gray-800 py-2.5 rounded-lg text-sm font-medium hover:bg-green-500 hover:text-white transition">
                    Save Changes
                </button>
                <a href="{{ path('app_profile') }}" class="flex-1 text-center border border-white/30 text-white py-2.5 rounded-lg text-sm font-medium hover:bg-white/10 transition">
                    Cancel
                </a>
            </div>
            
        {{ form_end(form) }}
        
    </div>
</div>
{% endblock %}