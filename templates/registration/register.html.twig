<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register | Gemz Crystalline</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/build/app.css">
  <style>
    /* Line input styling */
    .line-input {
      background: transparent;
      border: none;
      border-bottom: 1.5px solid rgba(0, 0, 0, 0.15);
      border-radius: 0;
      padding: 0.5rem 0;
      padding-right: 2rem;
      transition: all 0.3s ease;
      font-size: 0.9rem;
    }
    
    .line-input:focus {
      outline: none;
      border-bottom-color: #014421;
      box-shadow: none;
    }
    
    .line-input::placeholder {
      color: rgba(0, 0, 0, 0.35);
      font-size: 0.9rem;
    }
    
    /* Password toggle button */
    .password-toggle {
      position: absolute;
      right: 0;
      bottom: 0.5rem;
      cursor: pointer;
      user-select: none;
      color: rgba(0, 0, 0, 0.35);
      transition: color 0.3s ease;
    }
    
    .password-toggle:hover {
      color: #014421;
    }
    
    .password-wrapper {
      position: relative;
      width: 100%;
    }

    /* Custom checkbox styling */
    .custom-checkbox {
      width: 1rem;
      height: 1rem;
      border-radius: 0.25rem;
      border: 1px solid #d1d5db;
      cursor: pointer;
    }
    
    .custom-checkbox:checked {
      background-color: #014421;
      border-color: #014421;
    }

    /* Floating error panel */
    .error-floating {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1000;
      animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
      from {
        transform: translateX(100%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }

    .error-floating.hide {
      animation: slideOut 0.3s ease-out forwards;
    }

    @keyframes slideOut {
      from {
        transform: translateX(0);
        opacity: 1;
      }
      to {
        transform: translateX(100%);
        opacity: 0;
      }
    }
  </style>
</head>
<body class="m-0 p-0 overflow-hidden">
  
  <!-- Floating Error Panel -->
  <div id="errorPanel" class="error-floating hidden">
    <div class="bg-red-500 text-white px-6 py-4 rounded-lg shadow-2xl flex items-center space-x-3">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <div>
        <p class="font-semibold" id="errorMessage">Email already registered!</p>
        <p class="text-sm opacity-90">Please login or use a different email</p>
      </div>
      <button onclick="closeErrorPanel()" class="ml-4 hover:opacity-75">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
  
  <!-- FULLSCREEN SPLIT LAYOUT - 60/40 RATIO -->
  <div class="flex h-screen w-screen">
    
    <!-- LEFT SIDE: Infographics (60%) with Gemz Crystalline Branding -->
    <div class="w-[60%] relative overflow-hidden">
      <!-- Background diagonal gradient -->
      <div class="absolute inset-0" style="background: linear-gradient(135deg, #014421 50%, #2D6A4F 50%);"></div>
      
      <!-- PARENT DIV - has the IMAGE as background with zoom -->
      <div class="relative z-10 w-full h-full bg-cover bg-center" 
           style="background-image: url('/images/misc/login.jpg'); background-size: 150%; background-position: center;">
        
        <!-- Dark overlay for better text readability -->
        <div class="absolute inset-0 bg-gradient-to-br from-[#014421]/70 to-[#2D6A4F]/70"></div>
        
        <!-- Content -->
        <div class="relative h-full flex flex-col justify-between p-10 overflow-y-auto">
          <!-- Top Section -->
          <div>
            <h2 class="text-5xl font-bold text-white mb-4 leading-tight">Join Our<br>Gemz Community</h2>
            <p class="text-white/80 text-xl leading-relaxed mb-10 max-w-lg">
              Create an account to discover authentic gemstones and handcrafted jewelry.
            </p>

            <!-- Features Grid - 2 columns -->
            <div class="grid grid-cols-2 gap-6 mb-8">
              <!-- Feature 1 -->
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-11 h-11 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
                <div>
